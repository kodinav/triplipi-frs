<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Contact</span></nav>
        <h1>{{ page.titleHtml | safe }}</h1>
        <p class="lead">{{ page.lead | safe }}</p>
      </div>
    </section>

    <section class="section">
      <div class="container-wide">
        <div class="contact-layout" id="partner" data-reveal>

          <!-- Channels sidebar — email is the single point of contact -->
          <aside>
            <div class="channel">
              <div class="lbl">Email</div>
              <a class="val" href="mailto:{{ settings.contactEmail }}">{{ settings.contactEmail }}</a>
              <div class="hint">For trip planning, package enquiries, partnerships, licensing, and editorial queries.</div>
            </div>
          </aside>

          <!-- Form -->
          <form class="contact-form" data-form data-form-name="Contact" data-success-message="Letter received. We'll write back within one working day.">
            <div class="form-grid">
              <div class="field">
                <label>Your name <span class="req">*</span></label>
                <input type="text" name="name" required placeholder="What should we call you?">
              </div>
              <div class="field">
                <label>Email <span class="req">*</span></label>
                <input type="email" name="email" required placeholder="hello@example.com">
              </div>
              <div class="field">
                <label>Phone <span class="req">*</span></label>
                <input type="tel" name="phone" required placeholder="+91 ..." pattern="[0-9+\-\s]+">
              </div>
              <div class="field">
                {# Same form for everyone; /contact#partner swaps this dropdown for partner packages (main.js) #}
                <label data-mode="general">I'm writing about</label>
                <label data-mode="partner" hidden>Partner package</label>
                <select name="subject" data-mode="general">
                  <option>Planning a trip</option>
                  <option>Package enquiry</option>
                  <option>Photography licensing</option>
                  <option>Partner application</option>
                  <option>Editorial / press</option>
                  <option>Something else</option>
                </select>
                <select name="subject" data-mode="partner" hidden disabled>
                  <option>Enquiring pricing</option>
                  <option>Silver package</option>
                  <option>Gold package</option>
                  <option>Platinum package</option>
                  <option>Custom partnership</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label>Your message</label>
              <textarea name="message" rows="6" placeholder="Tell us what you're thinking about — even a half-formed idea is enough to start a conversation."></textarea>
            </div>
            <div class="field consent-field">
              {# .check hides the native input and draws the tick on the .box span that must follow it #}
              <label class="check">
                <input type="checkbox" name="consent" value="Agreed" required>
                <span class="box" aria-hidden="true"></span>
                <span>I have read and agree to the <a href="/legal?p=privacy">privacy policy</a> and <a href="/legal?p=terms">terms &amp; conditions</a>, and consent to my submission being stored so we can respond. <span class="req">*</span></span>
              </label>
            </div>
            <input type="hidden" name="_form" value="Contact">
            <div>
              <button type="submit" class="btn btn-brand">Send the letter <span class="arrow">→</span></button>
            </div>
          </form>

        </div>
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
