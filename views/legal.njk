<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ doc.crumb }} — Triplipi</title>
  <meta name="description" content="Legal pages: Privacy Policy, Terms and Conditions, Website Usage, Cookies Policy, Copyright Information, Disclaimer, Affiliate Disclosure, and FAQs.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <meta name="theme-color" content="#D05527">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Legal</span><span>/</span><span>{{ doc.crumb }}</span></nav>
        <h1>{{ doc.title | safe }}</h1>
        <p class="lead">{{ doc.deck | safe }}</p>
      </div>
    </section>

    <section class="section">
      <div class="container-wide">
        <div class="legal-layout" data-reveal>

          <!-- Sidebar nav -->
          <aside class="legal-nav">
            <h6>Legal documents</h6>
            {% for d in legalDocs %}
            <a href="/legal?p={{ d.slug }}"{% if d.slug == doc.slug %} class="is-active"{% endif %}>{{ d.navLabel }}</a>
            {% endfor %}
            <hr class="rule" style="margin-block: var(--s-5);">
            <p style="font-size: var(--fs-micro); color: var(--c-text-muted); line-height: 1.6;">Last updated: 1 March 2026.<br>Document version 2.4.</p>
          </aside>

          <!-- Content -->
          <article class="legal-content">{{ doc.body | safe }}</article>

        </div>
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
