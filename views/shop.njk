{% import "_sponsor.njk" as sp %}{% import "_pagination.njk" as pg %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
        <!-- Tab switcher: Triplipi archive vs Shutterstock -->
    <section class="section-sm section-masthead" style="padding-bottom: 0; border-bottom: 1px solid var(--c-border);">
      <div class="container-wide">

        <div class="page-masthead">
          <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Shop</span></nav>
          <div class="page-masthead-row">
            <h1>{{ shop.heroTitle | safe if shop.heroTitle else 'License original <em>photography</em> &amp; <em>footage</em>.' }}</h1>
            <p class="lead">{{ shop.heroLead | safe if shop.heroLead else 'Every image and video in our archive is editor-shot or contributor-verified, available for editorial and commercial use. Browse, select, and request a custom quote — or visit our Shutterstock portfolio for instant licensing.' }}</p>
          </div>
        </div>

        <div class="shop-tab-switcher" data-reveal>
          <button class="shop-tab is-active" data-shop-tab="archive">
            <div class="tab-label">{{ shop.archiveTabLabel or 'Triplipi Archive' }}</div>
            <div class="tab-meta">{{ shop.archiveTabMeta or 'Custom licensing · Quote on request' }}</div>
          </button>
          <a class="shop-tab" id="shutterstock" href="{{ shop.ssUrl or '#' }}" data-external data-provider="Shutterstock" data-url="{{ shop.ssUrl or '' }}">
            <div class="tab-label">{{ shop.ssTabLabel or 'Shutterstock Portfolio' }}</div>
            <div class="tab-meta">{{ shop.ssTabMeta or 'Instant licensing · Standard rates' }}</div>
          </a>
        </div>
      </div>
    </section>

    <!-- Shop layout -->
    <section class="section" style="padding-top: var(--s-7);">
      <div class="container-wide">
        <div class="shop-layout" data-reveal>

          <!-- Media grid -->
          <div>
            <div class="shop-grid">
{% for it in items %}
              <article class="shop-tile" data-serial="{{ it.serial or ('AET-' + (loop.index)) }}" data-media-type="{{ (it.badge or 'Media') ~ (' · ' + it.spec if it.spec else '') }}">
                <div class="serial">{{ ((pagination.offset if pagination else 0) + loop.index) | pad3 }}</div>
                <span class="type-badge">{{ it.badge or ('Video · 4K' if it.type == 'video' else 'Photograph') }}</span>
                <img loading="lazy" src="{{ it.image }}" alt="{{ it.title | striptags }}">
                <div class="info">
                  <h4>{{ it.title }}</h4>
                  <p>{{ it.spec }}</p>
                </div>
                {# the + / ✓ glyph is drawn by .select-btn::before; a literal one here rendered twice #}
                <button class="select-btn" type="button" aria-label="Add to selection"></button>
              </article>
          {{ sp.banner(sponsorSlots[loop.index0], "sp-span-all") }}
{% else %}
              <p class="adm-empty" style="grid-column:1/-1;">No media has been added to the shop yet.</p>
{% endfor %}
            </div>

            {% if pagination and pagination.pages > 1 %}{{ pg.nav(pagination, baseUrl) }}{% endif %}

          </div>

          <!-- Selection panel sidebar -->
          <aside class="selection-panel">
            <div class="panel-head">
              <div class="panel-title">Your Selection <span class="selection-count">0</span></div>
              <div class="panel-meta">Selected items appear here</div>
            </div>

            <div class="selection-list"></div>

            <div class="shop-empty">
              <div class="empty-ico">+</div>
              <p>Tap an item below to add it. We'll quote based on your selection, intended usage, and territory.</p>
            </div>

            <div style="padding: 0 var(--s-5) var(--s-5);">
              <button class="btn btn-brand" style="width: 100%;" type="button" data-action="seek-quote">Seek a Quote <span class="arrow">→</span></button>
            </div>

            <!-- Quote form (expands on click) -->
            <form class="quote-form" data-quote-to="{{ shop.quoteEmail or settings.contactEmail }}">
              <h5>Tell us about the use</h5>
              <input type="text" name="name" placeholder="Your name *" required>
              <input type="email" name="email" placeholder="Email *" required>
              <input type="tel" name="phone" placeholder="Phone *" required>
              <textarea name="usage" rows="3" placeholder="Intended use (editorial, commercial, social, etc.)" style="padding: 14px var(--s-4); border: 1px solid var(--c-border); border-radius: var(--r-sm); font-family: var(--ff-text); font-size: 0.9rem; resize: vertical;"></textarea>
              <button class="btn btn-ember" type="button" data-action="submit-quote">Send quote request <span class="arrow">→</span></button>
              <p style="font-size: var(--fs-micro); color: var(--c-text-muted); text-align: center; margin: 4px 0 0;">We respond within 24 working hours.</p>
            </form>
          </aside>

        </div>
      </div>
    </section>

    <!-- Shutterstock CTA strip -->
    <section class="section" style="background: var(--c-ink); color: var(--c-bone);">
      <div class="container-wide">
        <div class="shop-cta" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--s-9); align-items: center;" data-reveal>
          <div>
            <p class="overline" style="border-color: rgba(245,239,230,0.2);">Instant Licensing</p>
            <h2 style="color: var(--c-bone);">{{ shop.ctaTitle | safe if shop.ctaTitle else 'Need it now? Browse our <em>Shutterstock portfolio</em>.' }}</h2>
            <p style="margin-bottom: var(--s-5);">{{ shop.ctaBody | safe if shop.ctaBody else 'A curated selection of our archive is available for instant licensing on Shutterstock. Standard editorial and commercial rates apply, with extended licenses available on request.' }}</p>
            <a href="{{ shop.ssUrl or '#' }}" class="btn btn-brand" data-external data-provider="Shutterstock" data-url="{{ shop.ssUrl or '' }}">Visit Shutterstock Portfolio <span class="arrow">→</span></a>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3);">
            <img loading="lazy" src="{{ shop.ctaImage1 or 'https://images.unsplash.com/photo-1561361513-2d000a50f0dc?w=600&q=80' }}" alt="" style="aspect-ratio: 3/4; object-fit: cover; border-radius: var(--r-md);">
            <img loading="lazy" src="{{ shop.ctaImage2 or 'https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=600&q=80' }}" alt="" style="aspect-ratio: 3/4; object-fit: cover; border-radius: var(--r-md); margin-top: var(--s-7);">
          </div>
        </div>
      </div>
    </section>

  </main>


  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
