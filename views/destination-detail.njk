{% import "_ads.njk" as ad %}{% import "_sponsor.njk" as sp %}{% import "_crumbs.njk" as bc %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="page-hero has-image">
      <div class="page-hero-bg" data-parallax="-0.06">
        <img src="{{ dest.heroImage or dest.image }}" alt="{{ dest.name }} landscape" srcset="{{ dest.heroImage or dest.image | srcset }}" sizes="100vw" decoding="async" fetchpriority="high">
      </div>
      <div class="page-hero-inner">
        {{ bc.bar(crumbs) }}
        <h1>{{ dest.name }}{% if dest.tagline %} — <em>{{ dest.tagline | lower }}</em>{% endif %}.</h1>
        {% if dest.lead %}<p class="lead">{{ dest.lead | safe }}</p>{% endif %}

        <div class="dest-meta-strip">
          {% if dest.season %}<div class="item"><div class="lbl">Best Season</div><div class="val">{{ dest.season }}</div></div>{% endif %}
          {% if dest.region %}<div class="item"><div class="lbl">Region</div><div class="val">{{ dest.region }}</div></div>{% endif %}
          {% if dest.altitude %}<div class="item"><div class="lbl">Altitude</div><div class="val">{{ dest.altitude }}</div></div>{% endif %}
          {% if dest.tripLength %}<div class="item"><div class="lbl">Trip Length</div><div class="val">{{ dest.tripLength }}</div></div>{% endif %}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container-wide">
        <div class="dest-detail">
          <article>

            {% if dest.overview %}
            <div class="dest-section" data-reveal>
              <p class="kicker">Overview</p>
              <h2>An overview of <em>where you're going</em>.</h2>
              <div class="rich-body">{{ dest.overview | safe }}</div>
            </div>
            {% endif %}

            {% if pageAds and pageAds | length %}
        <div class="ad-strip">{% for u in pageAds %}{{ ad.unit(u, ads, "") }}{% endfor %}</div>
        {% endif %}

{% if sponsors and sponsors | length %}
            {# FR-DEST-019 — sponsored packages, ads and affiliate links for this destination #}
            <div class="dest-sponsors" data-reveal>
              <p class="kicker">Sponsored</p>
              {% for s in sponsors %}{{ sp.banner(s, "sp-span-all") }}{% endfor %}
            </div>
            {% endif %}

            {% if dest.gallery and dest.gallery | length %}
            <div class="dest-gallery" data-reveal>
              {% for g in dest.gallery %}
              {% set gl = g | lower %}
              {% set isVid = ('.mp4' in gl) or ('.webm' in gl) or ('.mov' in gl) or ('.ogg' in gl) %}
              {% if isVid %}
              <a data-lightbox data-type="video" data-src="{{ g }}" data-hover-video class="gallery-tile is-video">
                <video src="{{ g }}" muted loop playsinline preload="metadata"></video>
                <div class="play-icon">▶</div>
              </a>
              {% else %}
              <a data-lightbox data-src="{{ g }}" class="gallery-tile"><img loading="lazy" src="{{ g }}" alt="" srcset="{{ g | srcset }}" sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" decoding="async"></a>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}

            {% set subs = [
              {k:'secSeason', kicker:'When to Visit', h:'<em>Season-wise</em> visit expectations.'},
              {k:'secReach', kicker:'Getting There', h:'<em>How</em> to reach.'},
              {k:'secStay', kicker:'Where to Stay', h:'Stay <em>options</em>.'},
              {k:'secTravel', kicker:'Getting Around', h:'Travel <em>options</em>.'},
              {k:'secActivities', kicker:'What to Do', h:'Activities <em>to do</em>.'},
              {k:'secLandmarks', kicker:'Places of Note', h:'Landmarks <em>to visit</em>.'},
              {k:'secNotes', kicker:'Good to Know', h:'A few <em>other notes</em>.'}
            ] %}
            {% for s in subs %}
              {% if dest[s.k] %}
              <div class="dest-section" data-reveal>
                <p class="kicker">{{ s.kicker }}</p>
                <h2>{{ s.h | safe }}</h2>
                <div class="rich-body">{{ dest[s.k] | safe }}</div>
              </div>
              {% endif %}
            {% endfor %}

            {% if not dest.overview and not dest.secSeason %}
            <div class="dest-section" data-reveal>
              <p class="kicker">Overview</p>
              <h2>{{ dest.name }}.</h2>
              <p>{{ dest.region }}{% if dest.tagline %} · {{ dest.tagline }}{% endif %}. Detailed guide content for this destination is being prepared.</p>
            </div>
            {% endif %}

            {% set extSubs = [
              {k:'extItinerary', kicker:'Suggested Itinerary', h:'A <em>day-by-day</em> plan.'},
              {k:'extFood', kicker:'Food & Cuisine', h:'What to <em>eat</em>.'},
              {k:'extCulture', kicker:'Culture & Festivals', h:'People, <em>customs</em> & festivals.'},
              {k:'extBudget', kicker:'Costs & Budget', h:'What it <em>costs</em>.'},
              {k:'extFaq', kicker:'Traveller FAQ', h:'Questions, <em>answered</em>.'}
            ] %}
            {% set hasExtended = dest.extItinerary or dest.extFood or dest.extCulture or dest.extBudget or dest.extFaq %}

            <div class="dest-foot-cta" data-reveal>
              {% if hasExtended %}
              <button type="button" class="btn btn-outline btn-lg" data-action="toggle-more" aria-expanded="false" aria-controls="dest-extended">
                <span class="rm-label">Read More About Destination</span>
              </button>
              {% endif %}
              {# FR-DEST-007 — Go For A Trip from the bottom of the page: this
                 destination's own category listing, or the categories page #}
              <a href="{% if dest.categories and dest.categories | length %}/destinations?cat={{ dest.categories[0] }}&amp;from=categories{% else %}/categories{% endif %}" class="btn btn-outline btn-lg">Find Trip Deals</a>
              {# Opens this destination's packages directly — no partner redirect or consent card #}
              <a href="/packages?d={{ dest.slug }}" class="btn btn-brand btn-lg">Check Packages <span class="arrow">→</span></a>
            </div>

            {# Extended guide — extra in-depth content, revealed below by "Read More About Destination" #}
            {% if hasExtended %}
            <div class="dest-extended" id="dest-extended" data-dest-more>
              <div class="dest-section dest-extended-head" data-reveal>
                <p class="kicker">The Complete Guide</p>
                <h2>{{ dest.name }} in <em>more depth</em>.</h2>
                <p>Everything above, expanded — a deeper guide for planning the trip in detail.</p>
              </div>
              {% for s in extSubs %}
                {% if dest[s.k] %}
                <div class="dest-section" data-reveal>
                  <p class="kicker">{{ s.kicker }}</p>
                  <h2>{{ s.h | safe }}</h2>
                  <div class="rich-body">{{ dest[s.k] | safe }}</div>
                </div>
                {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </article>

          <aside class="sidebar" data-reveal="left">
            <div class="info-card pkg-cta-card">
              <h3 class="h4-like">Verified packages</h3>
              <p style="font-size: var(--fs-small); color: var(--c-text-muted); margin-bottom: var(--s-4);">Sponsored &amp; affiliate trips for {{ dest.name }}, from our partner network.</p>
              <a href="/packages?d={{ dest.slug }}" class="btn btn-brand" style="width: 100%;">Check Packages <span class="arrow">→</span></a>
            </div>

            <div class="info-card">
              <h4>Quick Facts</h4>
              <dl>
                {% if dest.season %}<div><dt>Best Time</dt><dd>{{ dest.season }}</dd></div>{% endif %}
                {% if dest.currency %}<div><dt>Currency</dt><dd>{{ dest.currency }}</dd></div>{% endif %}
                {% if dest.language %}<div><dt>Language</dt><dd>{{ dest.language }}</dd></div>{% endif %}
                {% if dest.altitude %}<div><dt>Altitude</dt><dd>{{ dest.altitude }}</dd></div>{% endif %}
                {% if dest.tripLength %}<div><dt>Trip Length</dt><dd>{{ dest.tripLength }}</dd></div>{% endif %}
                {% if dest.difficulty %}<div><dt>Difficulty</dt><dd>{{ dest.difficulty }}</dd></div>{% endif %}
              </dl>
            </div>

            {% if related and related | length %}
            <div class="info-card">
              <h4>More destinations</h4>
              <ul style="display: grid; gap: var(--s-3);">
                {% for r in related %}
                <li><a href="/destination-detail?d={{ r.slug }}" class="link-editorial">{{ r.name | safe }}</a></li>
                {% endfor %}
              </ul>
            </div>
            {% endif %}
          </aside>

        </div>
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
