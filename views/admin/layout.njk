<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Admin{% endblock %} — Triplipi CMS</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body class="admin">
  <aside class="adm-side">
    <a class="adm-brand" href="/admin">
      <span class="mark">T</span>
      <span>Triplipi <small>CMS</small></span>
    </a>
    <nav>
      <div class="adm-group">Pages</div>
      {% for p in pages %}
        {% if not p.isSettings %}
          <a href="/admin/page/{{ p.key }}" class="{% if active == p.key %}is-active{% endif %}">{{ p.label }}</a>
        {% endif %}
      {% endfor %}
      <div class="adm-group">Tools</div>
      <a href="/admin/inbox" class="{% if active == 'inbox' %}is-active{% endif %}">Messages</a>
      <a href="/admin/links" class="{% if active == 'links' %}is-active{% endif %}">Link health</a>
      <div class="adm-group">Site</div>
      {% for p in pages %}
        {% if p.isSettings %}
          <a href="/admin/page/{{ p.key }}" class="{% if active == p.key %}is-active{% endif %}">{{ p.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="adm-side-foot">
      <a href="/" target="_blank" class="adm-view-site">View site ↗</a>
      <form method="post" action="/admin/logout"><button type="submit">Log out</button></form>
    </div>
  </aside>
  <main class="adm-main">
    {% if saved == '1' %}<div class="adm-toast">✓ Saved — the site is updated. <a href="{{ pageView or '/' }}" target="_blank">See it live ↗</a></div>{% endif %}
    {% block content %}{% endblock %}
  </main>
  <script src="/assets/js/admin.js"></script>
</body>
</html>
