{% extends "admin/layout.njk" %}
{% block title %}Dashboard{% endblock %}
{% block content %}
  <header class="adm-head">
    <div>
      <div class="adm-kicker">Dashboard</div>
      <h1>Welcome back.</h1>
      <p class="adm-sub">Everything you publish here is live the moment you save. Start with anything that needs attention.</p>
    </div>
    <a class="adm-btn ghost" href="/" target="_blank" rel="noopener">View site ↗</a>
  </header>

  {# ---------- needs attention: the only part that should ever be urgent ---------- #}
  <section class="adm-panel adm-attention">
    <h2 class="adm-panel-title">Needs your attention</h2>
    <div class="adm-attn-grid">
      <a class="attn {% if inboxCount %}is-hot{% endif %}" href="/admin/inbox">
        <span class="n">{{ inboxCount }}</span>
        <span class="l">Unread message{{ '' if inboxCount == 1 else 's' }}</span>
        <span class="go">Open inbox →</span>
      </a>
      <a class="attn {% if broken | length %}is-bad{% endif %}" href="/admin/links">
        <span class="n">{{ broken | length }}</span>
        <span class="l">Broken partner link{{ '' if broken | length == 1 else 's' }}</span>
        <span class="go">{% if linkScanAt %}Checked automatically{% else %}Run the first check{% endif %} →</span>
      </a>
      {% if not mailConfigured %}
      <a class="attn is-warn" href="/admin/inbox">
        <span class="n">!</span>
        <span class="l">Email delivery is not set up</span>
        <span class="go">Forms are saved to the Inbox only — see README → Email →</span>
      </a>
      {% endif %}
      <div class="attn {% if expiringSoon | length %}is-warn{% endif %}">
        <span class="n">{{ expiringSoon | length }}</span>
        <span class="l">Expiring in 14 days</span>
        <span class="go">
          {% if expiringSoon | length %}
            {% for e in expiringSoon %}{{ e.title | truncate(28) }}{% if not loop.last %} · {% endif %}{% endfor %}
          {% else %}Nothing expiring soon{% endif %}
        </span>
      </div>
      <div class="attn {% if content.totals.hidden %}is-warn{% endif %}">
        <span class="n">{{ content.totals.hidden }}</span>
        <span class="l">Hidden from the site</span>
        <span class="go">Items saved but not published</span>
      </div>
    </div>
  </section>

  {# ---------- traffic ---------- #}
  <div class="adm-two">
    <section class="adm-panel">
      <h2 class="adm-panel-title">Traffic</h2>
      <div class="adm-figs">
        <div class="fig"><span class="n">{{ stats.total }}</span><span class="l">Views all time</span></div>
        <div class="fig"><span class="n">{{ stats.today }}</span><span class="l">Views today</span></div>
        <div class="fig"><span class="n">{{ content.totals.live }}</span><span class="l">Live items</span></div>
      </div>
      {% if stats.days | length %}
        <div class="adm-spark" aria-hidden="true">
          {% for d in stats.days %}
            <span class="bar" style="height: {{ (d.views / stats.peak * 100) | round }}%" title="{{ d.day }}: {{ d.views }}"></span>
          {% endfor %}
        </div>
        <p class="adm-note">Last {{ stats.days | length }} day{{ '' if stats.days | length == 1 else 's' }} of visits.</p>
      {% else %}
        <p class="adm-note">No visits recorded yet.</p>
      {% endif %}
    </section>

    <section class="adm-panel">
      <h2 class="adm-panel-title">Most popular</h2>
      {% if stats.top | length %}
        <ol class="adm-top">
          {% for p in stats.top %}
            <li>
              <span class="rank">{{ loop.index }}</span>
              <span class="who"><strong>{{ p.label | truncate(42) }}</strong><small>{{ p.kind }}</small></span>
              <span class="views">{{ p.views }}</span>
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <p class="adm-note">Popular destinations, posts and packages appear here once the site has visitors.</p>
      {% endif %}
    </section>
  </div>

  {# ---------- what you have ---------- #}
  <section class="adm-panel">
    <h2 class="adm-panel-title">Your content
      <span class="adm-panel-note">{{ content.totals.live }} live · {{ content.totals.hidden }} hidden · {{ content.totals.archived }} archived</span>
    </h2>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>Collection</th><th>Live</th><th>Hidden</th><th>Archived</th><th>Total</th></tr></thead>
        <tbody>
          {% for r in content.rows %}
            <tr>
              <td class="co-label">{{ r.label }}</td>
              <td><span class="chip chip-live">{{ r.live }}</span></td>
              <td>{{ r.hidden if r.hidden else '—' }}</td>
              <td>{{ r.archived if r.archived else '—' }}</td>
              <td>{{ r.total }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  {# ---------- where to go ---------- #}
  <h2 class="adm-group-title">Content</h2>
  <div class="adm-cards">
    {% for p in pages %}{% if p.group == 'content' %}
      <a class="adm-card" href="/admin/page/{{ p.key }}">
        <h3>{{ p.label }}</h3>
        <p class="card-intro">{{ p.intro }}</p>
        <span class="go">Open →</span>
      </a>
    {% endif %}{% endfor %}
  </div>

  <h2 class="adm-group-title">Pages</h2>
  <div class="adm-cards">
    {% for p in pages %}{% if p.group == 'pages' %}
      <a class="adm-card" href="/admin/page/{{ p.key }}">
        <h3>{{ p.label }}</h3>
        <p class="card-intro">{{ p.intro }}</p>
        <span class="go">Open →</span>
      </a>
    {% endif %}{% endfor %}
  </div>

  <h2 class="adm-group-title">Money, partners &amp; settings</h2>
  <div class="adm-cards">
    {% for p in pages %}{% if p.group == 'money' or p.group == 'settings' %}
      <a class="adm-card" href="/admin/page/{{ p.key }}">
        <h3>{{ p.label }}</h3>
        <p class="card-intro">{{ p.intro }}</p>
        <span class="go">Open →</span>
      </a>
    {% endif %}{% endfor %}
    <a class="adm-card" href="/admin/links">
      <h3>Link health</h3>
      <p class="card-intro">Every partner and affiliate link is checked automatically; broken ones are listed here.</p>
      <span class="go">Open →</span>
    </a>
  </div>
{% endblock %}
