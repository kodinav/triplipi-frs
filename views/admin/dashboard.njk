{% extends "admin/layout.njk" %}
{% block title %}Dashboard{% endblock %}
{% block content %}
  <header class="adm-head">
    <div>
      <div class="adm-kicker">Dashboard</div>
      <h1>Pick a page to edit.</h1>
      <p class="adm-sub">Each page lists its sections in the order they appear on screen. Changes go live the moment you save.</p>
    </div>
  </header>

  {% if stats %}
  <div class="adm-stats">
    <div class="stat"><div class="n">{{ stats.total }}</div><div class="l">Total page views</div></div>
    <div class="stat"><div class="n">{{ stats.today }}</div><div class="l">Views today</div></div>
    <a class="stat link" href="/admin/inbox"><div class="n">{{ inboxCount }}</div><div class="l">Unread messages</div></a>
    <a class="stat link" href="/admin/links"><div class="n">↗</div><div class="l">Check link health</div></a>
  </div>
  {% if stats.top | length %}
  <div class="adm-toppages">
    <h3>Most-viewed pages</h3>
    <ol>
      {% for p in stats.top %}<li><span class="path">{{ p.path }}</span><span class="views">{{ p.views }}</span></li>{% endfor %}
    </ol>
  </div>
  {% endif %}
  {% endif %}

  {% if content %}
  <div class="adm-content-overview">
    <h3>Content overview
      <span class="co-totals">{{ content.totals.live }} live · {{ content.totals.archived }} archived · {{ content.totals.hidden }} hidden · {{ content.totals.scheduled }} scheduled</span>
    </h3>
    <table class="adm-content-table">
      <thead><tr><th>Collection</th><th>Total</th><th>Live</th><th>Archived</th><th>Hidden</th><th>Scheduled</th></tr></thead>
      <tbody>
        {% for r in content.rows %}
        <tr>
          <td class="co-label">{{ r.label }}</td>
          <td>{{ r.total }}</td>
          <td><span class="co-live">{{ r.live }}</span></td>
          <td>{{ r.archived if r.archived else '—' }}</td>
          <td>{{ r.hidden if r.hidden else '—' }}</td>
          <td>{{ r.scheduled if r.scheduled else '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <h2 class="adm-group-title">Pages</h2>
  <div class="adm-cards">
    {% for p in pages %}
      {% if not p.isSettings %}
        <a class="adm-card" href="/admin/page/{{ p.key }}">
          <div class="type">{{ p.sections | length }} section{{ 's' if p.sections | length > 1 }}</div>
          <h3>{{ p.label }}</h3>
          <p class="card-intro">{{ p.intro }}</p>
          <span class="go">Open →</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  <h2 class="adm-group-title">Site</h2>
  <div class="adm-cards">
    {% for p in pages %}
      {% if p.isSettings %}
        <a class="adm-card" href="/admin/page/{{ p.key }}">
          <div class="type">Brand · navigation · security</div>
          <h3>{{ p.label }}</h3>
          <p class="card-intro">{{ p.intro }}</p>
          <span class="go">Open →</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
{% endblock %}
