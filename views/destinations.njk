{% import "_crumbs.njk" as bc %}{% import "_pagination.njk" as pg %}{% import "_sponsor.njk" as sp %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <!-- Page hero -->
        <!-- Destination grid -->
    <section class="section section-masthead">
      <div class="container-wide">

        <div class="page-masthead">
          {{ bc.bar(crumbs) }}
          <div class="page-masthead-row">
            <h1>{{ page.titleHtml | safe }}</h1>
            <p class="lead">{{ page.lead | safe }}</p>
          </div>
        </div>

        <div class="featured-grid feat-grid-list" data-stagger>
{% for d in cards %}
          <article class="feat-card">
            <a class="feat-media" href="/destination-detail?d={{ d.slug }}{{ trail }}" aria-label="{{ d.name | striptags }} — view details">
              <img loading="lazy" src="{{ d.image }}" alt="{{ d.name | striptags }}">
            </a>
            <div class="feat-info">
              <div class="region">{{ d.region }}</div>
              <h3 class="name">{{ d.name | safe }}</h3>
              <div class="meta"><span>{{ d.season }}</span>{% if d.tagline %}<span class="dot"></span><span>{{ d.tagline }}</span>{% endif %}</div>
              <div class="feat-actions">
                <a class="act-details" href="/destination-detail?d={{ d.slug }}{{ trail }}">Know More <span>→</span></a>
                <a class="act-pkg" href="/packages?d={{ d.slug }}">Check Packages <span>→</span></a>
              </div>
            </div>
          </article>
{% endfor %}
        </div>

        {{ pg.nav(pagination, baseUrl) }}

      </div>
    </section>

  </main>


  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
