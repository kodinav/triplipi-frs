{% import "_pagination.njk" as pg %}{% import "_sponsor.njk" as sp %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
        <!-- Filter -->
    <section class="section-sm section-masthead" style="padding-bottom: var(--s-4); border-bottom: 1px solid var(--c-border);">
      <div class="container-wide">

        <div class="page-masthead">
          <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Gallery</span></nav>
          <div class="page-masthead-row">
            <h1>{{ page.titleHtml | safe }}</h1>
            <p class="lead">{{ page.lead | safe }}</p>
          </div>
        </div>

        <div class="gallery-filter" data-reveal>
          <span style="font-size: var(--fs-micro); letter-spacing: var(--ls-wider); text-transform: uppercase; color: var(--c-text-muted); margin-right: var(--s-2);">Filter</span>
          <button class="filter-chip is-active" data-filter="all">All <span>{{ items | length }}</span></button>
          <button class="filter-chip" data-filter="type:image">Photographs <span>{{ typeCounts.image }}</span></button>
          <button class="filter-chip" data-filter="type:video">Films <span>{{ typeCounts.video }}</span></button>
          {% for cat in categories %}
          <button class="filter-chip" data-filter="{{ cat.slug }}">{{ cat.label }} <span>{{ cat.count }}</span></button>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Masonry grid -->
    <section class="section" style="padding-top: var(--s-7);">
      <div class="container-wide">
        <div class="masonry" data-stagger>
{% for g in items %}
          <a data-lightbox{% if g.type == 'video' %} data-type="video"{% endif %} data-src="{{ g.src }}" data-cat="{{ g.category }}" data-kind="{{ g.type }}"{% if g.type == 'video' and g.src %} data-hover-video{% endif %} class="gallery-tile{% if g.type == 'video' %} is-video{% endif %}">
            {% if g.type == 'video' and g.src %}
            <video src="{{ g.src }}" poster="{{ g.image }}" muted loop playsinline preload="metadata"></video>
            {% else %}
            <img loading="lazy" src="{{ g.image }}" alt="{{ g.alt }}">
            {% endif %}
            {% if g.type == 'video' %}<div class="play-icon">▶</div>{% endif %}
            <div class="overlay"><span class="tag tag-plain">{{ g.label }}</span></div>
          </a>
          {{ sp.banner(sponsorSlots[loop.index0], "sp-span-all") }}
{% endfor %}
        </div>

        {{ pg.nav(pagination, baseUrl) }}

      </div>
    </section>

  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
