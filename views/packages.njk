{% import "_pagination.njk" as pg %}{% import "_sponsor.njk" as sp %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Packages</span></nav>
        <h1>{{ page.titleHtml | safe }}</h1>
        <p class="lead">{{ page.lead | safe }}</p>
      </div>
    </section>

    <section class="section">
      <div class="container-wide">
        <!-- Filter row (FR-PKG-006 — grouping by category) -->
        {% if categories and categories | length %}
        <div class="pkg-filters" data-reveal>
          <span class="label">Filter</span>
          <div class="pkg-chips">
            <a class="filter-chip{% if not activeCat %} is-active{% endif %}" href="/packages{% if dParam %}?d={{ dParam }}{% endif %}">All Packages</a>
            {% for cat in categories %}
            <a class="filter-chip{% if cat.slug == activeCat %} is-active{% endif %}" href="/packages?{% if dParam %}d={{ dParam }}&{% endif %}cat={{ cat.slug }}">{{ cat.label }}</a>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if destFilter %}
        <div class="pkg-dest-note" data-reveal>Showing packages for <strong>{{ destFilter }}</strong>. <a href="/packages">Show all packages</a></div>
        {% endif %}

        {% if packages and packages | length %}
        <div class="pkg-list" data-stagger>
{% for k in packages %}
          <article class="pkg-list-card pkg-type-{{ (k.badgeLabel or 'sponsored') | lower }}">
            <div class="pkg-list-media">
              <img loading="lazy" src="{{ k.image }}" alt="{{ k.title | striptags }}">
              {% if k.badgeLabel %}<span class="pkg-type-badge">{{ k.badgeLabel | upper }}</span>{% endif %}
            </div>
            <div class="pkg-list-body">
              <h3>{{ k.title | safe }}</h3>
              {% if k.duration %}<div class="pkg-list-dur"><span class="tick">✓</span> {{ k.duration }}</div>{% endif %}
              <div class="pkg-list-price">
                {% if k.priceUnit %}Starting from <strong>{{ k.price }}</strong> <small>{{ k.priceUnit }}</small>{% else %}<strong>{{ k.price }}</strong>{% endif %}
              </div>
              {% if k.ctaExternal and k.ctaUrl %}
              <a class="btn btn-brand pkg-explore" href="{{ k.ctaUrl }}" data-external data-provider="{{ k.ctaProvider }}" data-url="{{ k.ctaUrl }}">Explore Package <span class="arrow">→</span></a>
              {% else %}
              <a class="btn btn-brand pkg-explore" href="/package-quote?p={{ k.title | slug }}" data-external data-provider="{{ k.ctaProvider or (k.title | striptags) }}" data-url="/package-quote?p={{ k.title | slug }}" data-display="Secure quote request">Explore Package <span class="arrow">→</span></a>
              {% endif %}
            </div>
          </article>
{% endfor %}
        </div>

        {{ pg.nav(pagination, baseUrl) }}
        {% else %}
        <div class="pkg-empty" data-reveal>
          <p>We are updating this section. <em>Package updates coming soon.</em></p>
        </div>
        {% endif %}
      </div>
    </section>
  </main>


  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
