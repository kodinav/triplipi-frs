{% import "_pagination.njk" as pg %}{% import "_sponsor.njk" as sp %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <nav class="crumbs"><a href="/">Home</a><span>/</span>{% if activeCatLabel %}<a href="/packages">Packages</a><span>/</span><span>{{ activeCatLabel }}</span>{% else %}<span>Packages</span>{% endif %}</nav>
        <h1>{{ page.titleHtml | safe }}</h1>
        <p class="lead">{{ page.lead | safe }}</p>
      </div>
    </section>

    <section class="section">
      <div class="container-wide" id="packages">
        {# Category rail (FR-PKG-006) — the /categories taxonomy as round tiles.
           Links carry #packages so a click lands on the rail, not the hero.
           No data-reveal: its leftover clip-path: inset(0) cuts off the
           active ring, and navigation shouldn't fade in after every click. #}
        {% if categories and categories | length %}
        <nav class="pkg-cats" aria-label="Package categories">
          <a class="pkg-cat{% if not activeCat %} is-active{% endif %}" href="/packages{% if dParam %}?d={{ dParam | urlencode }}{% endif %}#packages"{% if not activeCat %} aria-current="page"{% endif %}>
            <span class="pkg-cat-img pkg-cat-all" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>
            </span>
            <span class="pkg-cat-label">All</span>
            <span class="pkg-cat-count">{{ totalAll }}</span>
          </a>
          {% for cat in categories %}
          <a class="pkg-cat{% if cat.slug == activeCat %} is-active{% endif %}" href="/packages?{% if dParam %}d={{ dParam | urlencode }}&{% endif %}cat={{ cat.slug }}#packages"{% if cat.slug == activeCat %} aria-current="page"{% endif %}>
            <span class="pkg-cat-img"><img loading="lazy" src="{{ cat.image }}" alt=""></span>
            <span class="pkg-cat-label">{{ cat.label }}</span>
            <span class="pkg-cat-count">{{ cat.count }}</span>
          </a>
          {% endfor %}
        </nav>
        {% endif %}

        {% if destFilter %}
        <div class="pkg-dest-note" data-reveal>Showing packages for <strong>{{ destFilter }}</strong>. <a href="/packages">Show all packages</a></div>
        {% endif %}

        {% if packages and packages | length %}
        <div class="pkg-list" data-stagger>
{% for k in packages %}
          <article class="pkg-list-card pkg-type-{{ (k.badgeLabel or 'sponsored') | lower }}">
            <div class="pkg-list-media">
              <img loading="lazy" src="{{ k.image }}" alt="{{ k.title | striptags }}">
              {% if k.badgeLabel %}<span class="pkg-type-badge">{{ k.badgeLabel | upper }}</span>{% endif %}
            </div>
            <div class="pkg-list-body">
              <h3>{{ k.title | safe }}</h3>
              {% if k.duration %}<div class="pkg-list-dur"><span class="tick">✓</span> {{ k.duration }}</div>{% endif %}
              <div class="pkg-list-price">
                {% if k.priceUnit %}Starting from <strong>{{ k.price }}</strong> <small>{{ k.priceUnit }}</small>{% else %}<strong>{{ k.price }}</strong>{% endif %}
              </div>
              {% if k.ctaExternal and k.ctaUrl %}
              <a class="btn btn-brand pkg-explore" href="{{ k.ctaUrl }}" data-external data-provider="{{ k.ctaProvider }}" data-url="{{ k.ctaUrl }}">Explore Package <span class="arrow">→</span></a>
              {% else %}
              <a class="btn btn-brand pkg-explore" href="/package-quote?p={{ k.title | slug }}" data-external data-provider="{{ k.ctaProvider or (k.title | striptags) }}" data-url="/package-quote?p={{ k.title | slug }}" data-display="Secure quote request">Explore Package <span class="arrow">→</span></a>
              {% endif %}
            </div>
          </article>
{% endfor %}
        </div>

        {{ pg.nav(pagination, baseUrl) }}
        {% else %}
        <div class="pkg-empty" data-reveal>
          {% if activeCat %}
          <p>No packages in {{ activeCatLabel }} <em>yet.</em></p>
          <a class="pkg-empty-all" href="/packages{% if dParam %}?d={{ dParam | urlencode }}{% endif %}#packages">Show all packages <span class="arrow">→</span></a>
          {% else %}
          <p>We are updating this section. <em>Package updates coming soon.</em></p>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </section>
  </main>


  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
