{% import "_pagination.njk" as pg %}{% import "_sponsor.njk" as sp %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Packages — Triplipi</title>
  <meta name="description" content="All available travel packages — sponsored, affiliate, and quote-on-request. Verified providers only, with consent-gated redirects.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <meta name="theme-color" content="#D05527">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Packages</span></nav>
        <h1>{{ page.titleHtml | safe }}</h1>
        <p class="lead">{{ page.lead | safe }}</p>
      </div>
    </section>

    <section class="section">
      <div class="container-wide">
        <!-- Filters -->
        <div class="pkg-filters" data-reveal>
          <span class="label">Filter:</span>
          <button class="filter-chip is-active" data-filter="all">All Packages</button>
          <button class="filter-chip">Sponsored</button>
          <button class="filter-chip">Affiliate</button>
          <button class="filter-chip">Quote Only</button>
          <button class="filter-chip">Mountains</button>
          <button class="filter-chip">Beach</button>
          <button class="filter-chip">Luxury</button>
          <button class="filter-chip">Budget</button>
        </div>

        <div class="pkg-grid cols-2" data-stagger>
{% for k in packages %}
          {% if sponsorSlots[loop.index0] %}{{ sp.banner(sponsorSlots[loop.index0], 'sp-span-grid') }}{% endif %}
          <article class="pkg-card">
            <div class="thumb">
              <img src="{{ k.image }}" alt="">
              {% if k.badgeLabel %}<span class="tag{% if k.badgeClass %} {{ k.badgeClass }}{% endif %} badge-pos">{{ k.badgeLabel }}</span>{% endif %}
            </div>
            <div class="body">
              <div class="pkg-region">{{ k.region }}</div>
              <h3>{{ k.title | safe }}</h3>
              <p style="font-size: 0.9rem;">{{ k.description | safe }}</p>
              <div class="pkg-meta">
                {% for s in k.metaSpans %}<span>{{ s }}</span>{% endfor %}
              </div>
              <div class="pkg-foot">
                {% if k.onRequest %}<div class="pkg-price" style="font-size: 1.1rem; font-family: var(--ff-text); font-style: italic;">{{ k.price }}</div>{% else %}<div class="pkg-price">{{ k.price }}<small>{{ k.priceUnit }}</small></div>{% endif %}
                {% if k.ctaExternal %}<a href="{{ k.ctaHref }}" class="btn btn-sm" data-external data-provider="{{ k.ctaProvider }}" data-url="{{ k.ctaUrl }}">{{ k.ctaLabel }} <span class="arrow">→</span></a>{% else %}<a href="{{ k.ctaHref }}" class="btn btn-sm">{{ k.ctaLabel }} <span class="arrow">→</span></a>{% endif %}
              </div>
            </div>
          </article>
{% endfor %}
        </div>

        {{ pg.nav(pagination, baseUrl) }}

      </div>
    </section>
  </main>


  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
