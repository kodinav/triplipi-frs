<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main class="article article--l{{ post.layout or '1' }}">
    <section class="article-hero">
      {% if post.heroImage or post.image %}
      <div class="article-hero-img" data-parallax="-0.06">
        <img src="{{ post.heroImage or post.image }}" alt="" loading="eager">
      </div>
      {% endif %}
      <div class="article-hero-inner">
        <nav class="crumbs" style="justify-content: center;">
          <a href="/">Home</a><span>/</span><a href="/blog">Blog</a><span>/</span><span>Story</span>
        </nav>
        {% if post.category %}<div class="article-category">{{ post.category }}</div>{% endif %}
        <h1>{{ post.title | safe }}</h1>
        {% if post.deck or post.excerpt %}<p class="article-deck">{{ post.deck | safe if post.deck else post.excerpt | safe }}</p>{% endif %}
        <div class="article-byline">
          <div class="avatar"></div>
          <div>
            <div class="name">{{ post.bylineSpans[1] if post.bylineSpans and post.bylineSpans | length > 1 else 'By Editor' }}</div>
            <div class="meta">{{ post.bylineSpans | join(' · ') if post.bylineSpans else '' }}</div>
          </div>
        </div>
      </div>
    </section>

    <article class="section">
      <div class="container-reading">
        {% if post.body %}
        <div class="article-body rich-body" data-reveal>{{ post.body | safe }}</div>
        {% else %}
        <div class="article-body" data-reveal>
          <p class="dropcap">{{ post.excerpt | safe if post.excerpt else 'This story is being written.' }}</p>
          <p>The full article for this post hasn't been added yet — add it in Admin → Blog → Post grid → this post → “Article body”.</p>
        </div>
        {% endif %}

        <div class="article-cta" data-reveal>
          <div>
            <h4>Inspired to go?</h4>
            <p>Plan a trip or see verified packages.</p>
          </div>
          <div class="article-cta-actions">
            <a href="/trip" class="btn btn-brand">Go For A Trip <span class="arrow">→</span></a>
            <a href="/packages" class="btn btn-ghost">Check Packages <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
    </article>

    {% if related and related | length %}
    <section class="section" style="background: var(--c-bone); border-top: 1px solid var(--c-border);">
      <div class="container-wide">
        <div class="section-head" data-reveal>
          <div>
            <p class="overline">Keep reading</p>
            <h2>More from <em>the blog</em>.</h2>
          </div>
          <a href="/blog" class="btn-text">All stories <span class="arrow">→</span></a>
        </div>
        <div class="blog-strip" data-stagger>
          {% for r in related %}
          <a class="blog-card" href="/blog-post?b={{ r.key }}">
            <div class="thumb"><img loading="lazy" src="{{ r.p.image }}" alt=""></div>
            <div class="category">{{ r.p.category }}</div>
            <h3>{{ r.p.title | safe }}</h3>
            <p class="excerpt">{{ r.p.excerpt | safe }}</p>
          </a>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
