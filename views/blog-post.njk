{% import "_ads.njk" as ad %}{% import "_sponsor.njk" as sp %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main class="article article--l{{ post.layout or '1' }}">
    {# The story opens on the first screen: the masthead (crumbs, title, deck,
       byline) sits at the top of the article card, with the hero picture under
       it — no separate full-height hero to scroll past. #}
    <article class="section section-masthead">
      <div class="container-reading">
        <div class="page-masthead article-masthead">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><a href="/blog">Blog</a><span>/</span><span>{{ post.category or 'Story' }}</span>
          </nav>
          <h1>{{ post.title | safe }}</h1>
          {% if post.deck or post.excerpt %}<p class="article-deck">{{ post.deck | safe if post.deck else post.excerpt | safe }}</p>{% endif %}
          <div class="article-byline">
            <div class="avatar"></div>
            <div>
              <div class="name">{{ post.bylineSpans[1] if post.bylineSpans and post.bylineSpans | length > 1 else 'By Editor' }}</div>
              <div class="meta">{{ post.bylineSpans | join(' · ') if post.bylineSpans else '' }}</div>
            </div>
          </div>
        </div>

        {% if post.heroImage or post.image %}
        <div class="article-hero-img" data-reveal>
          <img src="{{ post.heroImage or post.image }}" alt="" loading="eager" srcset="{{ post.heroImage or post.image | srcset }}" sizes="(max-width: 1024px) 100vw, 900px" decoding="async" fetchpriority="high">
        </div>
        {% endif %}
        {% if post.body %}
        <div class="article-body rich-body" data-reveal>{{ post.body | safe }}</div>

        {% else %}
        <div class="article-body" data-reveal>
          <p class="dropcap">{{ post.excerpt | safe if post.excerpt else 'This story is being written.' }}</p>
          <p>The full article for this post hasn't been added yet — add it in Admin → Blog → Post grid → this post → “Article body”.</p>
        </div>
        {% endif %}

        {% if post.story %}
        {# FR-BLOG-003 / FR-DEST-015 — the travel story & experience, a section of
           its own in every layout #}
        <section class="article-story" data-reveal aria-labelledby="story-title">
          <p class="overline">Travel story &amp; experience</p>
          <h2 id="story-title">How it <em>actually</em> went.</h2>
          <div class="rich-body">{{ post.story | safe }}</div>
        </section>
        {% endif %}

        {% if post.gallery and post.gallery | length %}
        {# FR-BLOG-005 / FR-DEST-018 — photos and films inside the story: a film
           auto-plays on hover, an image enlarges, and either opens full-size. #}
        <div class="article-gallery" data-reveal>
          {% for g in post.gallery %}
          {% set gl = g | lower %}
          {% set isVid = ('.mp4' in gl) or ('.webm' in gl) or ('.mov' in gl) or ('.ogg' in gl) %}
          {% if isVid %}
          <a data-lightbox data-type="video" data-src="{{ g }}" data-hover-video class="gallery-tile is-video">
            <video src="{{ g }}" muted loop playsinline preload="metadata"></video>
            <div class="play-icon">▶</div>
          </a>
          {% else %}
          <a data-lightbox data-src="{{ g }}" class="gallery-tile"><img loading="lazy" src="{{ g }}" alt="" srcset="{{ g | srcset }}" sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" decoding="async"></a>
          {% endif %}
          {% endfor %}
        </div>
        {% endif %}

{% if pageAds and pageAds | length %}
        <div class="ad-strip">{% for u in pageAds %}{{ ad.unit(u, ads, "") }}{% endfor %}</div>
        {% endif %}

        <div class="article-cta" data-reveal>
          <div>
            <h2 class="h4-like">Inspired to go?</h2>
            <p>See verified packages{% if dest %} for {{ dest.name }}{% endif %}.</p>
          </div>
          <div class="article-cta-actions">
            <a href="{% if dest and dest.cat %}/destinations?cat={{ dest.cat }}&amp;from=categories{% else %}/categories{% endif %}" class="btn btn-ghost">Find Trip Deals</a>
            <a href="/packages{% if dest %}?d={{ dest.slug }}{% endif %}" class="btn btn-brand">Check Packages <span class="arrow">→</span></a>
          </div>
        </div>

        {% if sponsors and sponsors | length %}
        {# FR-BLOG-008 — sponsored placements chosen for blog posts, consent-gated like everywhere else #}
        <div class="article-sponsors">
          {% for s in sponsors %}{{ sp.banner(s, "sp-span-all") }}{% endfor %}
        </div>
        {% endif %}
      </div>
    </article>

    {% if related and related | length %}
    <section class="section" style="background: var(--c-bone); border-top: 1px solid var(--c-border);">
      <div class="container-wide">
        <div class="section-head" data-reveal>
          <div>
            <p class="overline">Keep reading</p>
            <h2>More from <em>the blog</em>.</h2>
          </div>
          <a href="/blog" class="btn-text">All stories <span class="arrow">→</span></a>
        </div>
        <div class="blog-strip" data-stagger>
          {% for r in related %}
          <a class="blog-card" href="/blog-post?b={{ r.key }}">
            <div class="thumb"><img loading="lazy" src="{{ r.p.image }}" alt="" srcset="{{ r.p.image | srcset }}" sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" decoding="async"></div>
            <div class="category">{{ r.p.category }}</div>
            <h3>{{ r.p.title | safe }}</h3>
            <p class="excerpt">{{ r.p.excerpt | safe }}</p>
          </a>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
