{% import "_crumbs.njk" as bc %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
        <section class="section section-masthead">
      <div class="container-wide">

        <div class="page-masthead">
          {{ bc.bar(crumbs) }}
          <div style="display: flex; gap: var(--s-3); margin-bottom: var(--s-4); flex-wrap: wrap;">
          {% if pkg.badgeLabel %}<span class="tag{% if pkg.badgeClass %} {{ pkg.badgeClass }}{% endif %}">{{ pkg.badgeLabel }}</span>{% endif %}
          {% if pkg.region %}<span class="tag tag-outline">{{ pkg.region }}</span>{% endif %}
          </div>
          <div class="page-masthead-row">
            <h1>{{ pkg.title | safe }}</h1>
            {% if pkg.description %}<p class="lead">{{ pkg.description | safe }}</p>{% endif %}
          </div>
        </div>

        <div class="pkg-detail">

          <article>
            {% if pkg.image %}
            <div class="pkg-hero-img" data-reveal="scale"><img loading="lazy" src="{{ pkg.image }}" alt="" srcset="{{ pkg.image | srcset }}" sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" decoding="async"></div>
            {% endif %}

            <div class="pkg-tabs" data-reveal>
              <button class="pkg-tab is-active" data-tab="overview">Overview</button>
              {% if pkg.itinerary %}<button class="pkg-tab" data-tab="itinerary">Day-by-day</button>{% endif %}
              {% if pkg.inclusions and pkg.inclusions | length %}<button class="pkg-tab" data-tab="inclusions">Inclusions</button>{% endif %}
              {% if pkg.providerInfo or pkg.ctaProvider %}<button class="pkg-tab" data-tab="provider">Provider</button>{% endif %}
            </div>

            <div class="pkg-tab-pane" data-pane="overview" data-reveal>
              <h2 style="margin-bottom: var(--s-5); font-family: var(--ff-display); font-weight: 700; font-size: 2rem; letter-spacing:-0.02em;">About <em>this trip</em>.</h2>
              {% if pkg.overview %}<div class="rich-body">{{ pkg.overview | safe }}</div>
              {% else %}<p>{{ pkg.description | safe }}</p><p>Full itinerary and inclusions for this package are available on request — see the other packages for this destination, or continue to the provider.</p>{% endif %}
            </div>

            {% if pkg.itinerary %}
            <div class="pkg-tab-pane" data-pane="itinerary" style="display: none;">
              <h2 style="margin-bottom: var(--s-5);">Day-by-day <em>itinerary</em>.</h2>
              <div class="rich-body">{{ pkg.itinerary | safe }}</div>
            </div>
            {% endif %}

            {% if pkg.inclusions and pkg.inclusions | length %}
            <div class="pkg-tab-pane" data-pane="inclusions" style="display: none;">
              <h2 style="margin-bottom: var(--s-5);">What's <em>included</em>.</h2>
              <div class="dest-feature-list">
                {% for inc in pkg.inclusions %}
                <div class="dest-feature"><div class="ico">✓</div><div><h3 class="h5-like">{{ inc }}</h3></div></div>
                {% endfor %}
              </div>
            </div>
            {% endif %}

            {% if pkg.providerInfo or pkg.ctaProvider %}
            <div class="pkg-tab-pane" data-pane="provider" style="display: none;">
              <h2 style="margin-bottom: var(--s-5);">About the <em>provider</em>.</h2>
              <div class="sponsored-block">
                <span class="tag tag-sponsored badge-pos">Verified Partner</span>
                <h3 style="font-family: var(--ff-display); font-weight: 700; font-size: 1.5rem; margin-bottom: var(--s-3);">{{ pkg.ctaProvider or 'Our partner' }}</h3>
                {% if pkg.providerInfo %}<div class="rich-body" style="margin-bottom: var(--s-4);">{{ pkg.providerInfo | safe }}</div>{% endif %}
                {% if pkg.ctaExternal and pkg.ctaUrl %}<a href="#" class="btn-text" data-external data-provider="{{ pkg.ctaProvider }}" data-url="{{ pkg.ctaUrl }}">Visit operator website <span class="arrow">→</span></a>{% endif %}
              </div>
            </div>
            {% endif %}
          </article>

          <aside data-reveal="left">
            <div class="pkg-summary-card">
              <div class="price-row">
                <div>
                  <span class="lbl" style="font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: var(--ls-wider); color: var(--c-text-muted); display: block; margin-bottom: 4px;">Starting at</span>
                  <span class="price">{{ pkg.price }}{% if pkg.priceUnit %}<small>{{ pkg.priceUnit }}</small>{% endif %}</span>
                </div>
                {% if pkg.badgeLabel %}<span class="tag{% if pkg.badgeClass %} {{ pkg.badgeClass }}{% endif %}">{{ pkg.badgeLabel }}</span>{% endif %}
              </div>
              {% if pkg.inclusions and pkg.inclusions | length %}
              <ul class="includes">{% for inc in pkg.inclusions %}<li>{{ inc }}</li>{% endfor %}</ul>
              {% elif pkg.metaSpans and pkg.metaSpans | length %}
              <ul class="includes">{% for m in pkg.metaSpans %}<li>{{ m }}</li>{% endfor %}</ul>
              {% endif %}
              {% if pkg.ctaExternal and pkg.ctaUrl %}
              <a href="#" class="btn btn-brand" data-external data-provider="{{ pkg.ctaProvider }}" data-url="{{ pkg.ctaUrl }}" style="width: 100%;">Check Out Further <span class="arrow">→</span></a>
              <p style="font-size: var(--fs-micro); color: var(--c-text-muted); margin-top: var(--s-4); text-align: center;">Affiliate disclosure shown on next screen</p>
              {% endif %}
              <hr class="rule" style="margin-block: var(--s-5);">
              {# Same move as every other Check Packages button: straight to this
                 destination's packages, with no consent card or quote form. #}
              <a href="/packages{% if dest %}?d={{ dest.slug }}{% endif %}" class="btn btn-ghost" style="width: 100%;">Check Packages <span class="arrow">→</span></a>
            </div>
          </aside>

        </div>
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
