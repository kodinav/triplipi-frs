/* ============================================================
   PARTIALS — Reusable header, footer, mega menus, search, consent modal, etc.
   Injected at runtime so we only maintain markup in one place.
   ============================================================ */

(function () {
  'use strict';

  const partials = {

    // ====== HEADER ======
    header: `
      {% if siteTopBanners and siteTopBanners | length %}
      <div class="site-topbar" role="region" aria-label="Announcement">
        {% for b in siteTopBanners %}
        <a class="site-topbar-item" href="{{ b.href or '#' }}"{% if b.external %} data-external data-provider="{{ b.extProvider }}" data-url="{{ b.extUrl }}"{% endif %}>
          <span>{{ b.text | safe }}</span>{% if b.ctaLabel %} <strong>{{ b.ctaLabel }} →</strong>{% endif %}
        </a>
        {% endfor %}
      </div>
      {% endif %}
      <header class="site-header" role="banner">
        <div class="header-inner">
          <a href="/" class="brand" aria-label="{{ settings.brandName }} home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>{{ settings.brandName }}</span>
          </a>

          <nav class="nav-primary" aria-label="Primary">
            <button class="nav-link" data-mega="mega-destinations" data-path="/destinations" aria-haspopup="true" aria-expanded="false">Destination Guide</button>
            <button class="nav-link" data-mega="mega-trip" data-path="/trip" aria-haspopup="true" aria-expanded="false">Go For A Trip</button>
            <a class="nav-link" href="/packages">Check Packages</a>
            <button class="nav-link" data-mega="mega-picks" data-path="/picks" aria-haspopup="true" aria-expanded="false">Our Picks</button>
            <a class="nav-link" href="/gallery">Gallery</a>
            <a class="nav-link" href="/about">About</a>
            <a class="nav-link" href="/announcements">Announcements</a>
            <a class="nav-link" href="/shop">Shop</a>
            <a class="nav-link" href="/blog">Blog</a>
            <a class="nav-link" href="/contact">Contact</a>
          </nav>

          <div class="nav-utils">
            <button class="icon-btn" data-action="open-search" aria-label="Search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
            <a href="{{ settings.headerCtaHref }}" class="btn btn-sm btn-brand">{{ settings.headerCtaLabel }}</a>
            <button class="menu-toggle icon-btn" aria-label="Menu" aria-expanded="false">
              <span></span><span></span><span></span>
            </button>
          </div>
        </div>
      </header>

      <!-- Mega menus -->
      <div class="mega-backdrop"></div>

      <!-- Destination Guide — 2-column category grid + View All (FRS 5.2) -->
      <div class="mega" id="mega-destinations">
        <div class="mega-inner mega-cats">
          <div class="mega-cats-head">
            <div class="mega-title"><em>Explore</em> by category</div>
            <div class="mega-tag">Every place is editor- or contributor-verified. Pick a category, or browse the full index.</div>
            <a class="btn-text" href="/destinations">View all destinations <span class="arrow">→</span></a>
          </div>
          <div class="mega-cat-grid">
            {% for cat in navCategories %}
            <a href="/destinations?cat={{ cat.slug }}"><span class="cat-name">{{ cat.label }}</span><span class="cat-count">{{ cat.count }}</span></a>
            {% endfor %}
            <a class="mega-cat-all" href="/destinations">View all categories <span class="arrow">→</span></a>
          </div>
        </div>
      </div>

      <!-- Go For A Trip — same categories, into the 7-step funnel (FRS Flow 2) -->
      <div class="mega" id="mega-trip">
        <div class="mega-inner mega-cats">
          <div class="mega-cats-head">
            <div class="mega-title"><em>Plan</em> a trip — pick a category</div>
            <div class="mega-tag">Choose a category to see destinations, then verified packages — with full consent before any redirect.</div>
            <a class="btn-text" href="/trip">Start the 7-step planner <span class="arrow">→</span></a>
          </div>
          <div class="mega-cat-grid">
            {% for cat in navCategories %}
            <a href="/destinations?cat={{ cat.slug }}"><span class="cat-name">{{ cat.label }}</span><span class="cat-count">{{ cat.count }}</span></a>
            {% endfor %}
            <a class="mega-cat-all" href="/destinations">View all categories <span class="arrow">→</span></a>
          </div>
        </div>
      </div>

      <!-- Our Picks — the four curated lists (FRS 5.6) -->
      <div class="mega" id="mega-picks">
        <div class="mega-inner mega-cats">
          <div class="mega-cats-head">
            <div class="mega-title">Our <em>most cherished</em> places</div>
            <div class="mega-tag">Hand-curated lists — the places we'd send our closest friends, ranked and reasoned.</div>
            <a class="btn-text" href="/picks">View all picks <span class="arrow">→</span></a>
          </div>
          <div class="mega-picks-list">
            {% for l in pickLists %}
            <a href="/picks?list={{ l.key }}"><span class="num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span><span class="pl-name">{{ l.label }}</span><span class="pl-meta">{{ l.meta }}</span></a>
            {% else %}
            <a href="/picks"><span class="pl-name">Browse our picks</span></a>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Mobile drawer -->
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <div class="mobile-nav-inner">
          <button class="mobile-nav-link" data-sub="" aria-expanded="false">
            Destination Guide <span class="arrow">+</span>
          </button>
          <div class="mobile-nav-sub">
            {% for cat in navCategories %}<a href="/destinations?cat={{ cat.slug }}">{{ cat.label }}</a>
            {% endfor %}<a href="/destinations">View all destinations →</a>
          </div>

          <button class="mobile-nav-link" data-sub="" aria-expanded="false">
            Go For A Trip <span class="arrow">+</span>
          </button>
          <div class="mobile-nav-sub">
            {% for cat in navCategories %}<a href="/destinations?cat={{ cat.slug }}">{{ cat.label }}</a>
            {% endfor %}<a href="/trip">Start the planner →</a>
          </div>

          <a href="/packages" class="mobile-nav-link">Check Packages <span class="arrow">→</span></a>

          <button class="mobile-nav-link" data-sub="" aria-expanded="false">
            Our Picks <span class="arrow">+</span>
          </button>
          <div class="mobile-nav-sub">
            {% for l in pickLists %}<a href="/picks?list={{ l.key }}">{{ l.label }}</a>
            {% endfor %}<a href="/picks">View all picks →</a>
          </div>

          <a href="/gallery" class="mobile-nav-link">Gallery <span class="arrow">→</span></a>
          <a href="/about" class="mobile-nav-link">About <span class="arrow">→</span></a>
          <a href="/announcements" class="mobile-nav-link">Announcements <span class="arrow">→</span></a>
          <a href="/shop" class="mobile-nav-link">Shop <span class="arrow">→</span></a>
          <a href="/blog" class="mobile-nav-link">Blog <span class="arrow">→</span></a>
          <a href="/contact" class="mobile-nav-link">Contact <span class="arrow">→</span></a>
        </div>
        <div class="mobile-nav-footer">
          <span>{{ settings.copyright }}</span>
          <span>·</span>
          <a href="/legal">Privacy</a>
          <a href="/legal">Terms</a>
        </div>
      </nav>
    `,

    // ====== FOOTER ======
    footer: `
      {% if siteBottomBanners and siteBottomBanners | length %}
      <section class="section-sm promo-zone promo-zone--site-bottom">
        <div class="container-wide">
          {% for b in siteBottomBanners %}
          {% if b.style == 'wide' and b.image %}
          <a class="promo-banner promo-wide{% if b.animate %} promo-animate{% endif %}" href="{{ b.href or '#' }}" style="background-image: linear-gradient(rgba(35,31,32,.35), rgba(35,31,32,.5)), url('{{ b.image }}');"{% if b.external %} data-external data-provider="{{ b.extProvider }}" data-url="{{ b.extUrl }}"{% endif %}>
            <div class="promo-wide-inner"><div class="promo-text">{{ b.text | safe }}</div>{% if b.ctaLabel %}<span class="btn btn-brand btn-sm">{{ b.ctaLabel }} →</span>{% endif %}</div>
          </a>
          {% else %}
          <div class="promo-banner promo-strip{% if b.animate %} promo-animate{% endif %}">
            <span class="promo-text">{{ b.text | safe }}</span>
            {% if b.ctaLabel and b.href %}<a class="btn btn-sm btn-brand" href="{{ b.href }}"{% if b.external %} data-external data-provider="{{ b.extProvider }}" data-url="{{ b.extUrl }}"{% endif %}>{{ b.ctaLabel }} →</a>{% endif %}
          </div>
          {% endif %}
          {% endfor %}
        </div>
      </section>
      {% endif %}
      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-hero">
            <div>
              <p class="overline">Begin somewhere extraordinary</p>
              <h2>The next chapter of your story is <em>already being written</em>.</h2>
            </div>
            <div>
              <p>Plan a trip, license a photograph, or simply browse the world for a while. Our editors are here when you're ready.</p>
              <a href="/contact" class="btn btn-brand">Start with a conversation <span class="arrow">→</span></a>
            </div>
          </div>

          <div class="footer-cols">
            <div class="footer-col footer-brand-block">
              <a href="/" class="brand">
                <span class="brand-mark"></span>
                <span>{{ settings.brandName }}</span>
              </a>
              <p>A travel discovery platform for the discerning explorer. Curated destinations, verified packages, original photography.</p>
              <div class="footer-social">
                <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg></a>
                <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="m10 9 5 3-5 3z" fill="currentColor"/></svg></a>
                <a href="#" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M11 7v10M9 14l3-7 3 7"/></svg></a>
                <a href="#" aria-label="X / Twitter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 4 16 16M20 4 4 20"/></svg></a>
              </div>
            </div>

            <div class="footer-col">
              <h6>Explore</h6>
              <ul>
                <li><a href="/destinations">Destinations</a></li>
                <li><a href="/trip">Plan a Trip</a></li>
                <li><a href="/packages">Packages</a></li>
                <li><a href="/picks">Our Picks</a></li>
                <li><a href="/blog">Blog</a></li>
              </ul>
            </div>

            <div class="footer-col">
              <h6>Media</h6>
              <ul>
                <li><a href="/gallery">Gallery</a></li>
                <li><a href="/shop">License Photography</a></li>
                <li><a href="/shop#shutterstock">Shutterstock Portfolio</a></li>
                <li><a href="/announcements">Announcements</a></li>
              </ul>
            </div>

            <div class="footer-col">
              <h6>Company</h6>
              <ul>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/legal?p=faq">FAQs</a></li>
                <li><a href="/contact#partner">Become a partner</a></li>
                {% for p in customPages %}<li><a href="/p/{{ p.slug }}">{{ p.navLabel }}</a></li>
                {% endfor %}
              </ul>
            </div>

            <div class="footer-col">
              <h6>Legal</h6>
              <ul>
                {% for d in legalDocs %}{% if d.inFooter %}
                <li><a href="/legal?p={{ d.slug }}">{{ d.navLabel }}</a></li>
                {% endif %}{% endfor %}
              </ul>
            </div>
          </div>

          <div class="footer-bottom">
            <span>{{ settings.copyright }}</span>
            <ul>
              <li><a href="/legal?p=privacy">Privacy</a></li>
              <li><a href="/legal?p=terms">Terms</a></li>
              <li><a href="/legal?p=cookies">Cookies</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
            <span>Crafted in Bareilly · Built for the curious</span>
          </div>
        </div>
      </footer>
    `,

    // ====== SEARCH OVERLAY ======
    search: `
      <div class="search-overlay" role="dialog" aria-modal="true" aria-label="Search">
        <div class="search-overlay-header">
          <div class="search-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input class="search-input" type="search" placeholder="Where to next…" autocomplete="off" spellcheck="false">
            <button class="search-close">Close (esc)</button>
          </div>
        </div>
        <div class="search-body">
          <div class="search-results-wrap">
            <div class="search-filters">
              <button class="filter-chip is-active" data-filter="all">All Results</button>
              <button class="filter-chip" data-filter="destination">Destinations</button>
              <button class="filter-chip" data-filter="package">Packages</button>
              <button class="filter-chip" data-filter="blog">Blog</button>
              <button class="filter-chip" data-filter="announcement">Announcements</button>
            </div>

            <section class="search-section">
              <h6>Suggested Destinations</h6>
              <a class="search-result" data-type="destination" href="/destinations">
                <div class="thumb"><img src="https://images.unsplash.com/photo-1605640840605-14ac1855827b?w=200&q=70" alt=""></div>
                <div>
                  <div class="type">Destination · Mountains</div>
                  <h4>Ladakh — The High Desert</h4>
                  <p>Buddhist monasteries, motorcycle passes, and the highest motorable roads on earth.</p>
                </div>
                <span class="arrow">→</span>
              </a>
              <a class="search-result" data-type="destination" href="/destinations">
                <div class="thumb"><img src="https://images.unsplash.com/photo-1582510003544-4d00b7f74220?w=200&q=70" alt=""></div>
                <div>
                  <div class="type">Destination · Islands</div>
                  <h4>Andaman Islands</h4>
                  <p>Pristine beaches, coral reefs, and the slow rhythm of island time.</p>
                </div>
                <span class="arrow">→</span>
              </a>
              <a class="search-result" data-type="destination" href="/destinations">
                <div class="thumb"><img src="https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=200&q=70" alt=""></div>
                <div>
                  <div class="type">Destination · Backwaters</div>
                  <h4>Kerala — God's Own Country</h4>
                  <p>Houseboat slow-mornings on the Vembanad, spice gardens, and the Western Ghats.</p>
                </div>
                <span class="arrow">→</span>
              </a>
            </section>

            <section class="search-section">
              <h6>Packages &amp; Trips</h6>
              <a class="search-result" data-type="package" href="/package-detail">
                <div class="thumb"><img src="https://images.unsplash.com/photo-1626621341517-bbf3d9990a23?w=200&q=70" alt=""></div>
                <div>
                  <div class="type">Package · 7 days</div>
                  <h4>Spiti Valley Circuit — Premium Edition</h4>
                  <p>Kaza, Key Monastery, Chandratal, Langza. Curated by Trans-Himalayan partners.</p>
                </div>
                <span class="arrow">→</span>
              </a>
              <a class="search-result" data-type="package" href="/package-detail">
                <div class="thumb"><img src="https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=200&q=70" alt=""></div>
                <div>
                  <div class="type">Package · 5 days</div>
                  <h4>Kerala Backwater Houseboat Retreat</h4>
                  <p>Alleppey to Kumarakom with all-inclusive luxury houseboat stays.</p>
                </div>
                <span class="arrow">→</span>
              </a>
            </section>

            <section class="search-section">
              <h6>From the Blog</h6>
              <a class="search-result" data-type="blog" href="/blog-post">
                <div class="thumb"><img src="https://images.unsplash.com/photo-1571536802807-30451e3955d8?w=200&q=70" alt=""></div>
                <div>
                  <div class="type">Story · 14 min read</div>
                  <h4>What I learned about silence in the high passes of Ladakh</h4>
                  <p>An essay on solitude, altitude, and the unexpected geography of attention.</p>
                </div>
                <span class="arrow">→</span>
              </a>
              <a class="search-result" data-type="announcement" href="/announcements">
                <div class="thumb"><img src="https://images.unsplash.com/photo-1494791368093-85217fbbf8de?w=200&q=70" alt=""></div>
                <div>
                  <div class="type">Announcement · 2 days ago</div>
                  <h4>Monsoon Sale — Up to 35% off Kerala packages</h4>
                  <p>Verified partners running early-bird discounts until 15 July.</p>
                </div>
                <span class="arrow">→</span>
              </a>
            </section>
          </div>
        </div>
      </div>
    `,

    // ====== CONSENT MODAL ======
    consent: `
      <div class="modal-root" id="consent-modal" role="dialog" aria-modal="true" aria-labelledby="consent-title">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog">
          <div class="modal-header">
            <div class="modal-eyebrow">External Redirect Notice</div>
            <h3 class="modal-title" id="consent-title">You're about to leave <em>Triplipi</em></h3>
            <p style="font-size: var(--fs-small); color: var(--c-text-muted);">Before you continue, please review the disclosure below and confirm your consent.</p>
            <button class="modal-close" aria-label="Close consent modal"></button>
          </div>

          <div class="modal-body">
            <div class="modal-provider">
              <div class="ico">P</div>
              <div>
                <div class="pname">Provider Name</div>
                <div class="purl">https://provider.example.com</div>
              </div>
            </div>

            <div class="disclosure">
              <h6>Affiliate Disclosure</h6>
              <p>Triplipi may earn a commission if you book through this link. This does not affect what you pay, and we only partner with verified providers we have personally vetted.</p>
            </div>

            <div class="disclosure" style="border-left-color: var(--c-ember);">
              <h6>Personal Data Sharing</h6>
              <p>By continuing, browser information (referrer, language, device type) may be shared with the destination site. No personal account data from Triplipi is shared.</p>
            </div>

            <div style="display: grid; gap: var(--s-3); margin-top: var(--s-5);">
              <label class="check">
                <input type="checkbox">
                <span class="box"></span>
                <span>I have read and agree to the legal disclaimer and acknowledge that Triplipi is not liable for transactions or content on the external website.</span>
              </label>
              <label class="check">
                <input type="checkbox">
                <span class="box"></span>
                <span>I consent to limited personal data sharing as described above for the purpose of this redirect.</span>
              </label>
            </div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-ghost" data-action="consent-decline">Decline</button>
            <button class="btn btn-brand" data-action="consent-agree" disabled>Continue to provider <span class="arrow">→</span></button>
          </div>
        </div>
      </div>
    `,

    // ====== LIGHTBOX ======
    lightbox: `
      <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
        <button class="lightbox-close" aria-label="Close">×</button>
        <button class="lightbox-nav prev" aria-label="Previous">‹</button>
        <button class="lightbox-nav next" aria-label="Next">›</button>
        <div class="lightbox-inner"></div>
      </div>
    `,

    // ====== PAGE LOADER ======
    loader: `
      <div class="page-loader">
        <div class="mark">T</div>
      </div>
    `
  };


  // Inject partials wherever data-include is found OR mount commonly into known slots
  const mount = (slot, html) => {
    const el = document.querySelector(slot);
    if (el) el.outerHTML = html;
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Mount by attribute placeholders
    mount('[data-partial="header"]', partials.header);
    mount('[data-partial="footer"]', partials.footer);
    mount('[data-partial="search"]', partials.search);
    mount('[data-partial="consent"]', partials.consent);
    mount('[data-partial="lightbox"]', partials.lightbox);
    mount('[data-partial="loader"]', partials.loader);
  }, { once: true });

})();
