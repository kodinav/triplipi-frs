/* ============================================================
   PARTIALS — Reusable header, footer, mega menus, search, consent modal, etc.
   Injected at runtime so we only maintain markup in one place.
   ============================================================ */

(function () {
  'use strict';

  const partials = {

    // ====== HEADER ======
    header: `
      {% if siteTopBanners and siteTopBanners | length %}
      <div class="site-topbar" role="region" aria-label="Announcement">
        {% for b in siteTopBanners %}
        <a class="site-topbar-item" href="{{ b.href or '#' }}"{% if b.external %} data-external data-provider="{{ b.extProvider }}" data-url="{{ b.extUrl }}"{% endif %}>
          <span>{{ b.text | safe }}</span>{% if b.ctaLabel %} <strong>{{ b.ctaLabel }} →</strong>{% endif %}
        </a>
        {% endfor %}
      </div>
      {% endif %}
      <header class="site-header" role="banner">
        <div class="header-inner">
          <a href="/" class="brand" aria-label="{{ settings.brandName }} home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>{{ settings.brandName }}</span>
          </a>

          <nav class="nav-primary" aria-label="Primary">
            <a class="nav-link nav-home" href="/" aria-label="Home" title="Home">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 10v8.5A2.5 2.5 0 0 0 8 21h8a2.5 2.5 0 0 0 2.5-2.5V10"/><path d="M9 21v-7a3 3 0 0 1 6 0v7"/><circle cx="12.9" cy="17.6" r=".8" fill="currentColor" stroke="none"/></svg>
            </a>
            {% for link in settings.navLinks %}{% if link.mega and link.mega != 'none' %}
            <button class="nav-link" data-mega="mega-{{ link.mega }}" data-path="{{ link.href }}"{% if link.mega == 'resources' %} data-paths="/travel-tips,/gallery,/blog,/about"{% endif %} aria-haspopup="true" aria-expanded="false">{{ link.label }}</button>
            {% elif link.href == '/contact' %}
            {# Contact is keyed off its href, not link.mega, so it works against
               live content.json without an admin edit. #}
            <button class="nav-link" data-mega="mega-contact" data-path="/contact" aria-haspopup="true" aria-expanded="false">{{ link.label }}</button>
            {% else %}
            <a class="nav-link" href="{{ link.href }}">{{ link.label }}</a>
            {% endif %}{% endfor %}
          </nav>

          <div class="nav-utils">
            <button class="icon-btn" data-action="open-search" aria-label="Search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
            <a href="{{ settings.headerCtaHref }}" class="btn btn-sm btn-brand">{{ settings.headerCtaLabel }}</a>
            <button class="menu-toggle icon-btn" aria-label="Menu" aria-expanded="false">
              <span></span><span></span><span></span>
            </button>
          </div>
        </div>
      </header>

      <!-- Mega menus -->
      <div class="mega-backdrop"></div>

      <!-- Destination — category list dropdown (Destination Tab doc) -->
      <div class="mega mega-list" id="mega-destinations">
        <div class="mega-list-inner">
          <div class="mega-picks-list mega-picks-simple">
            {% for cat in navCategories %}
            <a href="/destinations?cat={{ cat.slug }}"><span class="pl-name">{{ cat.label }}</span></a>
            {% endfor %}
            <a href="/categories" class="mega-trip-all"><span class="pl-name">All Destination Categories</span></a>
          </div>
        </div>
      </div>

      <!-- Our Picks — compact list dropdown -->
      <div class="mega mega-list" id="mega-picks">
        <div class="mega-list-inner">
          <div class="mega-list-head">
            <span class="mega-list-title">Our most cherished places</span>
            <a class="mega-list-all" href="{{ settings.megaMenus.picksHeadHref or '/picks' }}">View all <span class="arrow">→</span></a>
          </div>
          <div class="mega-picks-list mega-picks-simple">
            {% for l in pickLists %}
            <a href="/picks?list={{ l.key }}"><span class="pl-name">{{ l.label }}</span></a>
            {% else %}
            <a href="/picks"><span class="pl-name">Browse our picks</span></a>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Resources — the reading pages, gathered under one tab -->
      <div class="mega mega-list" id="mega-resources">
        <div class="mega-list-inner">
          <div class="mega-picks-list mega-picks-simple">
            <a href="/travel-tips"><span class="pl-name">Travel Tips</span></a>
            <a href="/gallery"><span class="pl-name">Gallery</span></a>
            <a href="/blog"><span class="pl-name">Blog</span></a>
