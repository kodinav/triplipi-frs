          <div class="mobile-nav-sub">
            {% for cat in navCategories %}<a href="/destinations?cat={{ cat.slug }}">{{ cat.label }}</a>
            {% endfor %}<a href="{{ link.href }}">View All Categories →</a>
          </div>
          {% elif link.mega == 'picks' %}
          <button class="mobile-nav-link" data-sub="" aria-expanded="false">{{ link.label }} <span class="arrow">+</span></button>
          <div class="mobile-nav-sub">
            {% for l in pickLists %}<a href="/picks?list={{ l.key }}">{{ l.label }}</a>
            {% endfor %}<a href="{{ link.href }}">View all picks →</a>
          </div>
          {% elif link.mega == 'resources' %}
          <button class="mobile-nav-link" data-sub="" aria-expanded="false">{{ link.label }} <span class="arrow">+</span></button>
          <div class="mobile-nav-sub">
            <a href="/travel-tips">Travel Tips</a>
            <a href="/gallery">Gallery</a>
            <a href="/blog">Blog</a>
