            </div>

            <div class="disclosure" style="border-left-color: var(--c-ember);">
              <h6>Personal Data Sharing</h6>
              <p>By continuing, browser information (referrer, language, device type) may be shared with the destination site. No personal account data from Triplipi is shared.</p>
            </div>

            <div style="display: grid; gap: var(--s-3); margin-top: var(--s-5);">
              <label class="check">
                <input type="checkbox">
                <span class="box"></span>
                <span>I have read and agree to the legal disclaimer and acknowledge that Triplipi is not liable for transactions or content on the external website.</span>
              </label>
              <label class="check">
                <input type="checkbox">
                <span class="box"></span>
                <span>I consent to limited personal data sharing as described above for the purpose of this redirect.</span>
              </label>
            </div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-ghost" data-action="consent-decline">Decline</button>
            <button class="btn btn-brand" data-action="consent-agree" disabled>Continue to provider <span class="arrow">→</span></button>
          </div>
        </div>
      </div>
    `,

    // ====== LIGHTBOX ======
    lightbox: `
      <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
        <button class="lightbox-close" aria-label="Close">×</button>
        <button class="lightbox-nav prev" aria-label="Previous">‹</button>
        <button class="lightbox-nav next" aria-label="Next">›</button>
        <div class="lightbox-inner"></div>
      </div>
    `,

    // ====== PAGE LOADER ======
    loader: `
      <div class="page-loader">
        <div class="mark">T</div>
      </div>
    `
  };


  // Inject partials wherever data-include is found OR mount commonly into known slots
  const mount = (slot, html) => {
    const el = document.querySelector(slot);
    if (el) el.outerHTML = html;
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Mount by attribute placeholders
    mount('[data-partial="header"]', partials.header);
    mount('[data-partial="footer"]', partials.footer);
    mount('[data-partial="search"]', partials.search);
    mount('[data-partial="consent"]', partials.consent);
    mount('[data-partial="lightbox"]', partials.lightbox);
    mount('[data-partial="loader"]', partials.loader);
  }, { once: true });

  /* ---------- Google AdSense loader (FR-HOME-014 and friends) ----------
     A <script> tag written into an injected partial never executes, so the
     library is attached here, once, and only when ads are switched on. */
  {% if ads and ads.enabled %}
  (function () {
    if (document.querySelector('script[data-adsense]')) return;
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ ads.publisherId }}';
    s.crossOrigin = 'anonymous';
    s.setAttribute('data-adsense', '1');
    document.head.appendChild(s);
  })();
  {% endif %}

  /* ---------- copy & download protection (FR-OTHER-008) ----------
     Assumption A7: a deterrent against casual copying, not a guarantee —
     developer tools and screenshots are out of reach. Every layer is
     switched from Site settings. */
  {% if settings.protectContent %}
  (function () {
    const selectionOff = {{ 'true' if settings.protectSelection else 'false' }};
    const watermark = {{ ('"' + settings.watermarkText + '"') | safe if settings.watermarkText else 'null' }};
    const inField = (el) => el && el.closest && el.closest('input, textarea, select, [contenteditable="true"]');

    document.addEventListener('contextmenu', (e) => { if (!inField(e.target)) e.preventDefault(); });
    document.addEventListener('dragstart', (e) => {
      if (e.target && /^(IMG|VIDEO|PICTURE)$/.test(e.target.tagName)) e.preventDefault();
    });
    document.addEventListener('copy', (e) => { if (!inField(e.target)) e.preventDefault(); });
    document.addEventListener('keydown', (e) => {
      if (inField(e.target)) return;                    // forms keep working
      const k = (e.key || '').toLowerCase();
      const mod = e.ctrlKey || e.metaKey;
      if (mod && ['c', 'x', 's', 'p', 'u', 'a'].includes(k)) { e.preventDefault(); return; }
      if (k === 'f12' || (mod && e.shiftKey && ['i', 'j', 'c'].includes(k))) e.preventDefault();
    });

    const root = document.documentElement;
    if (selectionOff) root.classList.add('no-select');
    if (watermark) {
      root.style.setProperty('--wm-text', '"' + String(watermark).replace(/"/g, '') + '"');
      root.classList.add('has-watermark');
    }
  })();
  {% endif %}

})();
