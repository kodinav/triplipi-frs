      <!-- Mobile drawer (same links as the header bar) -->
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <div class="mobile-nav-inner">
          {% for link in settings.navLinks %}
          {% if link.mega == 'destinations' or link.mega == 'trip' %}
