                <span>{{ settings.brandName }}</span>
              </a>
              <p>A travel discovery platform for the discerning explorer. Curated destinations, verified packages, original photography.</p>
              {# FR-HOME-022 — social links come from Site settings; an empty one is left out,
                 and each is consent-gated like every other outbound link (FR-LINK-003). #}
              <div class="footer-social">
                {% if settings.socialInstagram %}<a href="{{ settings.socialInstagram }}" aria-label="Instagram" data-external data-provider="Instagram" data-url="{{ settings.socialInstagram }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg></a>{% endif %}
                {% if settings.socialYoutube %}<a href="{{ settings.socialYoutube }}" aria-label="YouTube" data-external data-provider="YouTube" data-url="{{ settings.socialYoutube }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="m10 9 5 3-5 3z" fill="currentColor"/></svg></a>{% endif %}
                {% if settings.socialFacebook %}<a href="{{ settings.socialFacebook }}" aria-label="Facebook" data-external data-provider="Facebook" data-url="{{ settings.socialFacebook }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 3h-3a4 4 0 0 0-4 4v3H5v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>{% endif %}
                {% if settings.socialPinterest %}<a href="{{ settings.socialPinterest }}" aria-label="Pinterest" data-external data-provider="Pinterest" data-url="{{ settings.socialPinterest }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M11 7v10M9 14l3-7 3 7"/></svg></a>{% endif %}
                {% if settings.socialX %}<a href="{{ settings.socialX }}" aria-label="X / Twitter" data-external data-provider="X" data-url="{{ settings.socialX }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 4 16 16M20 4 4 20"/></svg></a>{% endif %}
              </div>
            </div>

            <div class="footer-col">
              <h6>Explore</h6>
              <ul>
                <li><a href="/destinations">Destinations</a></li>
                <li><a href="/packages">Check Packages</a></li>
                <li><a href="/picks">Our Picks</a></li>
                <li><a href="/blog">Blog</a></li>
                <li><a href="/legal?p=faq">FAQs</a></li>
              </ul>
            </div>

            <div class="footer-col">
              <h6>Media</h6>
              <ul>
                <li><a href="/travel-tips">Travel Tips</a></li>
                <li><a href="/gallery">Gallery</a></li>
                <li><a href="/shop#shutterstock">Shutterstock Portfolio</a></li>
              </ul>
            </div>

            <div class="footer-col">
              <h6>Company</h6>
              <ul>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/contact#partner">Become a partner</a></li>
                {% for p in customPages %}<li><a href="/p/{{ p.slug }}">{{ p.navLabel }}</a></li>
