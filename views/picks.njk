{% import "_pagination.njk" as pg %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Our Picks</span></nav>
        <h1>{{ page.titleHtml | safe }}</h1>
        <p class="lead">{{ page.lead | safe }}</p>
      </div>
    </section>

    <!-- List selector -->
{% if lists and lists | length %}
    <section class="section-sm" style="padding-top: var(--s-6); padding-bottom: var(--s-4);">
      <div class="container-wide">
        <div class="picks-tabs" data-reveal>
{% for l in lists %}
          <a class="picks-tab{% if active and l.key == active.key %} is-active{% endif %}" href="/picks?list={{ l.key }}">
            <span class="num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <span class="name">{{ l.label }}</span>
            <span class="meta">{{ l.meta or (l.count ~ ' places') }}</span>
          </a>
{% endfor %}
        </div>
      </div>
    </section>
{% endif %}

    <section class="section" style="padding-top: var(--s-5);">
      <div class="container-wide">
        <div class="section-head" data-reveal>
          <div>
            <p class="overline">{{ active.label if active else 'Our Picks' }}</p>
            <h2>{{ active.heading | safe if active and active.heading else 'The places we’d send our <em>closest friends</em>.' }}</h2>
          </div>
        </div>

        <div class="featured-grid feat-grid-list" data-stagger>
{% for p in picks %}
          <article class="feat-card">
            <a class="feat-media" href="{% if p.dest %}/destination-detail?d={{ p.dest.slug }}{% else %}{{ p.href or '/destinations' }}{% endif %}" aria-label="{{ p.name | striptags }}">
              <img loading="lazy" src="{{ p.image }}" alt="{{ p.name | striptags }}">
            </a>
            <div class="feat-info">
              <div class="region">{{ p.region }}</div>
              <h3 class="name">{{ p.name | safe }}</h3>
              {% if p.dest and (p.dest.season or p.dest.tagline) %}
              <div class="meta">{% if p.dest.season %}<span>{{ p.dest.season }}</span>{% endif %}{% if p.dest.season and p.dest.tagline %}<span class="dot"></span>{% endif %}{% if p.dest.tagline %}<span>{{ p.dest.tagline }}</span>{% endif %}</div>
              {% endif %}
              <div class="feat-actions">
                <a class="act-details" href="{% if p.dest %}/destination-detail?d={{ p.dest.slug }}{% else %}{{ p.href or '/destinations' }}{% endif %}">Know More <span>→</span></a>
                {% if p.affiliate %}
                <a class="act-pkg" href="{{ p.affiliate.url }}" data-external data-provider="{{ p.affiliate.provider }}" data-url="{{ p.affiliate.url }}">Go For A Trip <span>→</span></a>
                {% else %}
                <a class="act-pkg" href="/destinations">Go For A Trip <span>→</span></a>
                {% endif %}
              </div>
            </div>
          </article>
{% else %}
          <p class="adm-empty">No places in this list yet.</p>
{% endfor %}
        </div>

        {{ pg.nav(pagination, baseUrl) }}

        <!-- Bottom CTA -->
        <div style="text-align: center; margin-top: var(--s-10); padding-top: var(--s-10); border-top: 1px solid var(--c-border);" data-reveal>
          <p class="overline center">Methodology</p>
          <h3 style="font-family: var(--ff-display); font-weight: var(--fw-light); font-size: 1.8rem; margin-bottom: var(--s-4);">How we <em>rank</em> these.</h3>
          <p style="max-width: 540px; margin: 0 auto;">Each list is curated by our editors — visited personally or independently verified within the last 18 months. Rankings consider season-window, accessibility, cultural depth, and how well a place rewards slow travel.</p>
        </div>
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
