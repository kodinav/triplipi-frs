{% import "_ads.njk" as ad %}{% import "_sponsor.njk" as sp %}{% import "_pagination.njk" as pg %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
        <!-- Masthead + list selector -->
    <section class="section-sm section-masthead" style="padding-bottom: var(--s-4);">
      <div class="container-wide">

        <div class="page-masthead">
          <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Our Picks</span></nav>
          <div class="page-masthead-row">
            <h1>{{ page.titleHtml | safe }}</h1>
            <p class="lead">{{ page.lead | safe }}</p>
          </div>
        </div>
{% if lists and lists | length %}
        <div class="picks-tabs" data-reveal>
          <a class="picks-tab picks-tab-all{% if not active %} is-active{% endif %}" href="/picks?list=all"{% if not active %} aria-current="page"{% endif %}>
            <span class="num" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>
            </span>
            <span class="name">All</span>
            <span class="meta">{{ totalAll }} places</span>
          </a>
{% for l in lists %}
          <a class="picks-tab{% if active and l.key == active.key %} is-active{% endif %}" href="/picks?list={{ l.key }}">
            <span class="num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <span class="name">{{ l.label }}</span>
            <span class="meta">{{ l.meta or (l.count ~ ' places') }}</span>
          </a>
{% endfor %}
        </div>
{% endif %}
      </div>
    </section>

    <section class="section" style="padding-top: var(--s-5);">
      <div class="container-wide">
        <div class="section-head" data-reveal>
          <div>
            <p class="overline">{{ active.label if active else 'All picks' }}</p>
            <h2>{{ (active.heading if active and active.heading else 'Every list, <em>all in one place</em>.') | safe }}</h2>
            {% if not active %}<p class="picks-all-note">{{ totalAll }} places across {{ lists | length }} lists — or pick a list above.</p>{% endif %}
          </div>
        </div>

        <div class="featured-grid feat-grid-list" data-stagger>
{% for p in picks %}
          <article class="feat-card">
            <a class="feat-media" href="{% if p.dest %}/destination-detail?d={{ p.dest.slug }}&amp;from=picks          {{ sp.banner(sponsorSlots[loop.index0], "sp-span-all") }}
          {{ ad.unit(adSlots[loop.index0], ads, "ad-span-all") }}
{% else %}{{ p.href or '/destinations' }}{% endif %}" aria-label="{{ p.name | striptags }}">
              <img loading="lazy" src="{{ p.image }}" alt="{{ p.name | striptags }}" srcset="{{ p.image | srcset }}" sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" decoding="async">
            </a>
            <div class="feat-info">
              <div class="region">{{ p.region }}</div>
              <h3 class="name">{{ p.name | safe }}</h3>
              {% if p.dest and (p.dest.season or p.dest.tagline) %}
              <div class="meta">{% if p.dest.season %}<span>{{ p.dest.season }}</span>{% endif %}{% if p.dest.season and p.dest.tagline %}<span class="dot"></span>{% endif %}{% if p.dest.tagline %}<span>{{ p.dest.tagline }}</span>{% endif %}</div>
              {% endif %}
              <div class="feat-actions">
                <a class="act-details" href="{% if p.dest %}/destination-detail?d={{ p.dest.slug }}&amp;from=picks{% else %}{{ p.href or '/destinations' }}{% endif %}">Know More <span>→</span></a>
                <a class="act-pkg" href="/packages{% if p.dest %}?d={{ p.dest.slug }}{% endif %}">Check Packages <span>→</span></a>
              </div>
            </div>
          </article>
{% else %}
          <p class="adm-empty">No places in this list yet.</p>
{% endfor %}
        </div>

        {{ pg.nav(pagination, baseUrl) }}

        <!-- Bottom CTA -->
        <div style="text-align: center; margin-top: var(--s-10); padding-top: var(--s-10); border-top: 1px solid var(--c-border);" data-reveal>
          <p class="overline center">Methodology</p>
          <h3 style="font-family: var(--ff-display); font-weight: var(--fw-light); font-size: 1.8rem; margin-bottom: var(--s-4);">How we <em>rank</em> these.</h3>
          <p style="max-width: 540px; margin: 0 auto;">Each list is curated by our editors — visited personally or independently verified within the last 18 months. Rankings consider season-window, accessibility, cultural depth, and how well a place rewards slow travel.</p>
        </div>
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
