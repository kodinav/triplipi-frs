<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">

  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/animations.css">
  <link rel="stylesheet" href="/assets/css/pages.css">
  <link rel="stylesheet" href="/assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    {% if page.heroImage %}
    <section class="page-hero page-hero--image" style="background-image: linear-gradient(rgba(35,31,32,.45), rgba(35,31,32,.55)), url('{{ page.heroImage }}');">
      <div class="page-hero-inner">
        <nav class="crumbs"><a href="/">Home</a><span>/</span><span>{{ page.crumb or page.navLabel }}</span></nav>
        <h1>{{ page.title | safe }}</h1>
        {% if page.deck %}<p class="lead">{{ page.deck | safe }}</p>{% endif %}
      </div>
    </section>
    {% endif %}

    <section class="section section-masthead">
      <div class="container-narrow">

        {# With a hero image the title lives up there; without one, the masthead
           carries the crumbs and title at the top of this card. #}
        {% if not page.heroImage %}
        <div class="page-masthead">
          <nav class="crumbs"><a href="/">Home</a><span>/</span><span>{{ page.crumb or page.navLabel }}</span></nav>
          <div class="page-masthead-row">
            <h1>{{ page.title | safe }}</h1>
            {% if page.deck %}<p class="lead">{{ page.deck | safe }}</p>{% endif %}
          </div>
        </div>
        {% endif %}

        <article class="rich-body legal-content" data-reveal>{{ page.body | safe }}</article>
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="/assets/js/partials.js"></script>
  <script src="/assets/js/main.js"></script>
</body>
</html>
