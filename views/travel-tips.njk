<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
        <section class="section section-masthead">
      <div class="container-wide">

        <div class="page-masthead">
          <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Travel Tips</span></nav>
          <div class="page-masthead-row">
            <h1>{{ (page.titleHtml or 'Travel <em>Tips</em>') | safe }}</h1>
            {% if page.lead %}<p class="lead">{{ page.lead | safe }}</p>{% endif %}
          </div>
        </div>

        {# One block per topic, top to bottom ("Travel Tips Tab" doc): section name,
           one representational image, the text, then up to two affiliate/sponsor
           links. Wide screens put the image and text side by side across the full
           page width; smaller screens stack them in the doc's order. The doc rules
           out the redirect prompt card, so the links are plain new-tab links —
           never data-external. #}
{% for t in tips %}
        <article class="tip" id="{{ t.anchor }}" data-reveal>
          <h2 class="tip-title">{{ t.title }}</h2>
          <div class="tip-grid{% if not t.image %} no-media{% endif %}">
            {% if t.image %}<figure class="tip-media"><img loading="lazy" src="{{ t.image }}" alt="{{ t.imageAlt or t.title }}" srcset="{{ t.image | srcset }}" sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" decoding="async"></figure>{% endif %}
            <div class="tip-content">
              <div class="tip-body rich-body legal-content">{{ t.body | safe }}</div>
              {% if (t.link1Label and t.link1Url) or (t.link2Label and t.link2Url) %}
              <ul class="tip-links">
                {% if t.link1Label and t.link1Url %}<li><a href="{{ t.link1Url }}" rel="sponsored" data-external data-provider="{{ t.link1Url | host }}" data-url="{{ t.link1Url }}">{{ t.link1Label }} <span class="arrow" aria-hidden="true">↗</span></a></li>{% endif %}
                {% if t.link2Label and t.link2Url %}<li><a href="{{ t.link2Url }}" rel="sponsored" data-external data-provider="{{ t.link2Url | host }}" data-url="{{ t.link2Url }}">{{ t.link2Label }} <span class="arrow" aria-hidden="true">↗</span></a></li>{% endif %}
              </ul>
              {% endif %}
            </div>
          </div>
        </article>
{% else %}
        <div class="pkg-empty" data-reveal><p>Travel tips are on their way. <em>Check back soon.</em></p></div>
{% endfor %}
      </div>
    </section>
  </main>

  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
