{# Sponsored banner — inserted mid-grid. `span` class adapts it to the host layout. #}
{% macro banner(s, span) %}
  {% if s %}
    <aside class="sp-banner {{ span }}" aria-label="Sponsored">
      <div class="sp-media">
        <img loading="lazy" src="{{ s.image }}" alt="{{ s.partner }}">
      </div>
      <div class="sp-body">
        <div class="sp-kicker"><span class="dot"></span>Sponsored · {{ s.kind | title }}</div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.description | safe }}</p>
        {% if s.partner %}<div class="sp-partner">{{ s.partner }}</div>{% endif %}
      </div>
      <div class="sp-actions">
        {% if s.phone %}
          <a class="btn btn-brand sp-call" href="tel:{{ s.phone | replace(' ', '') }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {{ s.callLabel or 'Call now' }}
          </a>
        {% endif %}
        {# FR-LINK-003 / FR-CONSENT-001: no outbound link without the consent notice #}
        {% if s.linkUrl %}
          <a class="btn btn-ghost" href="{{ s.linkUrl }}" data-external data-provider="{{ s.partner or s.title }}" data-url="{{ s.linkUrl }}">{{ s.linkLabel or 'Visit partner' }}</a>
        {% elif s.providerEmail %}
          {# FR-HOME-016 — a partner with no website gets a consent-gated enquiry form #}
          <a class="btn btn-ghost" href="/package-quote?sp={{ s._idx }}" data-external data-provider="{{ s.partner or s.title }}" data-url="/package-quote?sp={{ s._idx }}" data-display="Secure enquiry form">{{ s.linkLabel or 'Enquire' }}</a>
        {% endif %}
      </div>
    </aside>
  {% endif %}
{% endmacro %}
