<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% include "_seo.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,300italic,400,400italic,700,700italic,900|Open+Sans+Condensed:300,700&display=swap" rel="stylesheet">


  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="apple-touch-icon" href="assets/favicon.svg">

  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/layout.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/animations.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  <link rel="stylesheet" href="assets/css/mobile.css">
</head>
<body>
  <div data-partial="loader"></div>
  <div data-partial="header"></div>

  <main>
    <section class="search-page-head">
      <div class="container-wide">
        <nav class="crumbs"><a href="/">Home</a><span>/</span><span>Search</span></nav>
        <h1>{% if q %}Results for <em>"{{ q }}"</em>{% else %}Search <em>Triplipi</em>{% endif %}</h1>
        <p class="lead">{% if q %}{{ count }} match{{ '' if count == 1 else 'es' }} across destinations, packages, blog, announcements and pages.{% else %}Find destinations, packages, blog posts, announcements and pages.{% endif %}</p>

        <form class="page-search-form" method="get" action="/search">
          <div class="page-search-input">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" name="q" value="{{ q }}" placeholder="Search…" autofocus>
            <button class="btn btn-sm" type="submit">Search</button>
          </div>
        </form>
      </div>
    </section>

    {% if q and count %}
    <section class="section-sm" style="padding-top: var(--s-5); padding-bottom: var(--s-4); border-bottom: 1px solid var(--c-border);">
      <div class="container-wide">
        <div class="search-filter" data-reveal>
          <span style="font-size: var(--fs-micro); letter-spacing: var(--ls-wider); text-transform: uppercase; color: var(--c-text-muted); margin-right: var(--s-2);">Refine</span>
          <button class="filter-chip is-active" data-filter="all">All <span style="opacity:.6;">· {{ count }}</span></button>
          {% for t in ['Destination','Package','Blog','Announcement','Pick','Page'] %}
            {% set n = (results | selectattr('type','equalto',t) | list) | length %}
            {% if n %}<button class="filter-chip" data-filter="{{ t | lower }}">{{ t }}s <span style="opacity:.6;">· {{ n }}</span></button>{% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    <section class="section" style="padding-top: var(--s-7);">
      <div class="container-wide">
        {% if not q %}
          <p class="adm-empty" style="color: var(--c-text-muted);">Type a query above to search the site.</p>
        {% elif count == 0 %}
          <div data-reveal style="text-align:center; padding-block: var(--s-9);">
            <h3 style="font-family: var(--ff-display); font-weight:700; margin-bottom: var(--s-3);">No results for "{{ q }}".</h3>
            <p style="color: var(--c-text-muted);">Try a shorter or different keyword — e.g. a destination, package or topic.</p>
          </div>
        {% else %}
          <div class="search-results" data-stagger>
            {% for r in results %}
            <a class="search-result" data-type="{{ r.type | lower }}" href="{{ r.url }}">
              <div>
                <div class="type">{{ r.type }}{% if r.desc %} · {{ r.desc | striptags }}{% endif %}</div>
                <h4>{{ r.title | safe }}</h4>
              </div>
              <span class="arrow">→</span>
            </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  </main>


  <div data-partial="footer"></div>
  <div data-partial="search"></div>
  <div data-partial="consent"></div>
  <div data-partial="lightbox"></div>

  <script src="assets/js/partials.js"></script>
  <script src="assets/js/main.js"></script>
</body>
</html>
