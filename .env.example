# Copy to .env (or set these in the host's environment) to enable email
# delivery for the Contact, Ask for Guidance, Shop quote and package enquiry
# forms (FR-EMAIL-001). Until they are set, every submission is still saved
# to Admin → Inbox — nothing is lost, it just isn't emailed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_USER=postmaster@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Triplipi <no-reply@example.com>"

# Optional
PORT=3000
